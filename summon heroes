--- Systems.UnitUpgrades stat reroll (REROLL STATS UI). BuyStatReroll leaves a pending roll until RerollAction.
local STAT_REROLL_KEYS = { "Attack", "Health", "Cooldown", "Speed" }

local LETTER_RANK_SCORE = {
    D = 1,
    C = 2,
    B = 3,
    A = 4,
    S = 5,
    X = 6,
}

local STAT_REROLL_MODE_OPTIONS = {
    { text = "Always use new roll", value = "always" },
    { text = "Only if better (unlocked)", value = "better" },
}

