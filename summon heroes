local function parseCommaGoals(str)
    local out = {}
    if type(str) ~= "string" then
        return out
    end
    for piece in string.gmatch(str, "[^,]+") do
        local t = piece:match("^%s*(.-)%s*$")
        if t and #t > 0 then
            out[#out + 1] = t
        end
    end
    return out
end

function buildTraitGoalCsvFromInputs(csvText, selectedTraits)
    local out, seen = {}, {}
    local function add(s)
        if type(s) ~= "string" then
            return
        end
        s = s:match("^%s*(.-)%s*$") or ""
        if #s == 0 then
            return
        end
        local key = string.lower(s)
        if seen[key] then
            return
        end
        seen[key] = true
        out[#out + 1] = s
    end
    for _, s in ipairs(parseCommaGoals(csvText or "")) do
        add(s)
    end
    if type(selectedTraits) == "table" then
        for _, s in ipairs(selectedTraits) do
            add(s)
        end
    end
    return table.concat(out, ",")
end

