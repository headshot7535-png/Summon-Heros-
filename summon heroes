    local hold = prompt.HoldDuration
    pcall(function()
        prompt.HoldDuration = 0
    end)
    local ok = false
    if typeof(fireproximityprompt) == "function" then
        ok = select(1, pcall(fireproximityprompt, prompt))
    end
    if not ok and getgenv then
        local g = getgenv()
        if g and typeof(g.fireproximityprompt) == "function" then
            ok = select(1, pcall(g.fireproximityprompt, prompt))
        end
    end
    pcall(function()
        prompt.HoldDuration = hold
    end)
    if not ok and not _persist._BonusChestWarnedNoFirePrompt then
        _persist._BonusChestWarnedNoFirePrompt = true
        warn("[AutoBonusChests] fireproximityprompt missing — using E fallback.")
    end
    return ok
end

--- TP above queue pad (Main/Door) and fire prompt. Optional: getgenv().BonusChestFireBlueQueuePadPrompt / BonusChestFireRedQueuePadPrompt = true; BonusChestQueuePadPromptYOffset (studs, default 6).
function tryTeleportHumanoidToQueuePadPrompt(prompt, yStuds)
    yStuds = yStuds or 6
    if getgenv and type(getgenv().BonusChestQueuePadPromptYOffset) == "number" then
        yStuds = getgenv().BonusChestQueuePadPromptYOffset
    end
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return false
    end
    local par = prompt.Parent
    local part
    if par and par:IsA("Attachment") then
        part = par.Parent
    elseif par and par:IsA("BasePart") then
        part = par
    end
    if not part or not part:IsA("BasePart") then
        return false
    end
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false
    end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = part.CFrame * CFrame.new(0, yStuds, 0)
    end)
    task.wait(0.6)
    fireProximityPromptExec(prompt)
    return true
end

--- Wait until the local player finishes the prompt (hold E / interact). Fallback if executor cannot fire.
function waitForChestInteract(prompt, timeoutSec)
    timeoutSec = timeoutSec or 60
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
        return false
    end
    if not prompt.Enabled then
        return true
    end
    local done = false
    local c1 = connectTracked(prompt.Triggered, function(player)
        if player == LP then
            done = true
        end
    end)
    local c2 = connectTracked(prompt:GetPropertyChangedSignal("Enabled"), function()
        if not prompt.Enabled then
            done = true
        end
    end)
    local t0 = os.clock()
    while not done and prompt.Parent and (os.clock() - t0) < timeoutSec do
        task.wait(0.05)
    end
    pcall(function() c1:Disconnect() end)
    pcall(function() c2:Disconnect() end)
    return done
end

function moveToPrompt(root, part, prompt)
    if not root or not root.Parent or not part or not part.Parent then
        return
    end
    local attach = prompt.Parent
    local pos
    if attach and attach:IsA("Attachment") then
        pos = attach.WorldPosition
    else
        pos = part.Position
    end
    local maxDist = (prompt.MaxActivationDistance > 0 and prompt.MaxActivationDistance) or 8
    local delta = root.Position - pos
    local offset
    if delta.Magnitude > 1e-3 then
        offset = delta.Unit * (maxDist * 0.65)
    else
        offset = Vector3.new(0, 0, maxDist * 0.65)
    end
    if offset.Magnitude < 0.1 then
        offset = Vector3.new(0, 0, maxDist * 0.65)
    end
    pcall(function()
        root.CFrame = CFrame.new(pos + offset)
    end)
end

--- progressCb(i, total, msg) optional — e.g. update hint while waiting for E.
function collectAllChests(progressCb)
    local root = getRoot()
    if not root then
        return 0, "No character"
    end

    local opened = 0
    local parts = CollectionService:GetTagged("BonusChestPart")
    table.sort(parts, function(a, b)
        if not (a and a.Parent and b and b.Parent and root and root.Parent) then
            return false
        end
        local ok, da = pcall(function()
            return (a.Position - root.Position).Magnitude
        end)
        local ok2, db = pcall(function()
            return (b.Position - root.Position).Magnitude
        end)
        if not ok or not ok2 then
            return false
        end
        return da < db
    end)

    local n = #parts
    for i, part in ipairs(parts) do
        root = getRoot()
        if not root then
            return opened, nil
        end
        if part and part.Parent and part:IsDescendantOf(workspace) then
            local prompt = findChestPrompt(part)
            if prompt and prompt.Parent and prompt.Enabled then
                pcall(moveToPrompt, root, part, prompt)
                task.wait(0.12)
                if progressCb then
                    progressCb(i, n, ("Chest %d/%d — fireproximityprompt…"):format(i, n))
                end
                fireProximityPromptExec(prompt)
                task.wait(0.7)
                if prompt.Enabled and prompt.Parent then
                    if progressCb then
                        progressCb(i, n, ("Chest %d/%d — press E or waiting…"):format(i, n))
                    end
                    if not waitForChestInteract(prompt, 60) then
                        return opened, "Timed out on chest (try executor fireproximityprompt)"
                    end
                end
                opened = opened + 1
                task.wait(0.2)
            end
        end
    end

    return opened, nil
end

--- BasePart or Model tagged BonusChestPart (auto loop); manual collect still expects parts with .Position where sort uses it.
function getBonusChestWorldCFrame(inst)
    if not inst or not inst.Parent then
        return nil
    end
    if inst:IsA("BasePart") then
        return inst.CFrame
    end
    if inst:IsA("Model") then
        local ok, cf = pcall(function()
            return inst:GetPivot()
        end)
        return ok and cf or nil
    end
    return nil
end

