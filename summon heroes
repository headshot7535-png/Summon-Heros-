--- RotatingShops (Item Shop / PvP Shop): BuyItem remote + optional module for GetCurrentShopItems / HasStock.
--- Some games only replicate BuyItem under Systems.RotatingShops (no ModuleScript) — then use filter * and optional getgenv().BonusChestRotatingShopSlots.
local function findRotatingShopsModuleUnder(node)
    if not node or not node.FindFirstChild then
        return nil
    end
    local named = node:FindFirstChild("RotatingShops")
    if named and named:IsA("ModuleScript") then
        return named
    end
    for _, ch in ipairs(node:GetChildren()) do
        if ch:IsA("ModuleScript") then
            return ch
        end
    end
    for _, d in ipairs(node:GetDescendants()) do
        if d:IsA("ModuleScript") and d.Name == "RotatingShops" then
            return d
        end
    end
    for _, d in ipairs(node:GetDescendants()) do
        if d:IsA("ModuleScript") then
            return d
        end
    end
    return nil
end

local function resolveRotatingShopsBuy()
    local systems = getSystemsFolder()
    if not systems then
        return nil, nil
    end
    local node = systems:FindFirstChild("RotatingShops")
    if not node then
        return nil, nil
    end
    local buyEv
    local modScript
    if node:IsA("ModuleScript") then
        modScript = node
        buyEv = node.Parent and node.Parent:FindFirstChild("BuyItem")
    elseif node:IsA("Folder") then
        modScript = findRotatingShopsModuleUnder(node)
        buyEv = node:FindFirstChild("BuyItem")
    else
        buyEv = node:FindFirstChild("BuyItem")
        modScript = findRotatingShopsModuleUnder(node)
    end
    if not buyEv or not isShopBuyRemote(buyEv) then
        local sib = systems:FindFirstChild("BuyItem")
        if sib and isShopBuyRemote(sib) then
            buyEv = sib
        end
    end
    if not buyEv or not isShopBuyRemote(buyEv) then
        for _, d in ipairs(node:GetDescendants()) do
            if d.Name == "BuyItem" and isShopBuyRemote(d) then
                buyEv = d
                break
            end
        end
    end
    if not buyEv or not isShopBuyRemote(buyEv) then
        return nil, nil
    end
    if modScript and modScript:IsA("ModuleScript") then
        local ok, mod = pcall(require, modScript)
        if ok and type(mod) == "table" then
            return mod, buyEv
        end
    end
    return nil, buyEv
end

