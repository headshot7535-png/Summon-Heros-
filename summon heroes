local function tryStoryPadTeleportAndFirePromptOpenMapUi()
    if getgenv and getgenv().BonusChestStoryTeleportToPad == false then
        return false
    end
    if getgenv and getgenv().BonusChestStoryPadFirePrompt == false then
        return false
    end
    local prompt = findStoryMapSelectProximityPrompt()
    if not prompt then
        return false
    end
    local par = prompt.Parent
    local part
    if par and par:IsA("Attachment") then
        part = par.Parent
    elseif par and par:IsA("BasePart") then
        part = par
    end
    if not part or not part:IsA("BasePart") then
        return false
    end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false
    end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = part.CFrame * CFrame.new(0, 4, 0)
    end)
    local afterTp = 0.8
    if getgenv and type(getgenv().BonusChestStoryPadAfterTpWait) == "number" then
        afterTp = getgenv().BonusChestStoryPadAfterTpWait
    end
    task.wait(math.clamp(afterTp, 0.05, 3))
    if prompt.Enabled then
