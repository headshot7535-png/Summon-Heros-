local function _flushPersistWrite()
    if not _persistDirty then
        return
    end
    _persistDirty = false
    persistAllWriteNow()
end

persistAll = function(immediate)
    _persistDirty = true
    if immediate == true then
        _persistQueued = false
        _flushPersistWrite()
        return
    end
    if _persistQueued then
        return
    end
    _persistQueued = true
    task.delay(SETTINGS_SAVE_DEBOUNCE, function()
        _persistQueued = false
        _flushPersistWrite()
