--- Try m:Name(self, LP, ...) for common quest claim exports.
local function pcallQuestMethod(m, methodName, ...)
    if not m or type(m[methodName]) ~= "function" then
        return false
    end
    local args = { ... }
    local ok = pcall(function()
        if #args == 0 then
            m[methodName](m, LP)
        else
            m[methodName](m, LP, unpack(args))
        end
    end)
    return ok
end

local function tryClaimQuestCategoryViaModule(m, category)
    if category == "achievement" then
        local names = {
            "ClaimAllAchievements",
            "ClaimAchievements",
            "RedeemAllAchievements",
            "AutoClaimAchievements",
            "TryClaimAllAchievements",
        }
        for _, n in ipairs(names) do
            if pcallQuestMethod(m, n) then
                return true
            end
        end
        if pcallQuestMethod(m, "ClaimAll", "Achievements") or pcallQuestMethod(m, "ClaimAll", "Achievement") then
