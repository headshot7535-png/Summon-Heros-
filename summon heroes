if getgenv then
    if saved.queueOnTeleport then
        getgenv().BonusChestNoQueue = nil
    else
        getgenv().BonusChestNoQueue = true
    end
end

local NEXUSLIB_URLS = {
    "https://raw.githubusercontent.com/headshot7535-png/Nexuslib/main/Nexuslib",
    "https://raw.githubusercontent.com/headshot7535-png/Nexuslib/main/Nexuslib.lua",
}

local NexusLib
if readfile and pcall then
    local tryPaths = {}
    if getgenv and type(getgenv().NexusLibPath) == "string" then
        tryPaths[#tryPaths + 1] = getgenv().NexusLibPath
    end
    tryPaths[#tryPaths + 1] = "NexusLib.lua"
    for _, path in ipairs(tryPaths) do
        local ok, data = pcall(readfile, path)
        if ok and type(data) == "string" and #data > 500 then
            local lok, chunk = pcall(loadstring, data)
            if lok and chunk then
                local okm, mod = pcall(chunk)
                if okm and mod and type(mod) == "table" and mod.Window then
                    NexusLib = mod
                    break
                end
            end
        end
    end
end
if not NexusLib then
    for _, url in ipairs(NEXUSLIB_URLS) do
        local ok, mod = pcall(function()
            local src = game:HttpGet(url, true)
            if src and #src > 100 then
                return loadstring(src)()
            end
        end)
        if ok and type(mod) == "table" and mod.Window then
            NexusLib = mod
            break
        end
    end
end
if not NexusLib or not NexusLib.Window then
    error("[AutoBonusChests] NexusLib failed to load. Check HttpService / readfile.")
end

-- Raw script (Summon-Heros); re-fetched after teleport / server hop.
local SCRIPT_SOURCE_URL = (getgenv and getgenv().BonusChestScriptUrl)
    or "https://raw.githubusercontent.com/headshot7535-png/Summon-Heros-/main/summon%20heroes"

local function tryQueueOnTeleport()
    if getgenv and getgenv().BonusChestNoQueue == true then
        return false, "skipped"
    end
    local code = string.format("loadstring(game:HttpGet(%q, true))()", SCRIPT_SOURCE_URL)
    local candidates = {
        typeof(queue_on_teleport) == "function" and queue_on_teleport,
        typeof(syn) == "table" and syn.queue_on_teleport,
        typeof(fluxus) == "table" and fluxus.queue_on_teleport,
        typeof(Krnl) == "table" and Krnl.queue_on_teleport,
        getgenv and typeof(getgenv().queue_on_teleport) == "function" and getgenv().queue_on_teleport,
    }
    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            local ok = pcall(fn, code)
            if ok then
                return true, nil
            end
        end
    end
    return false, "no_api"
end

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer

--- True if this GuiObject and ancestors are visible and owning ScreenGui (if any) is enabled.
local function guiObjectShownOnScreen(inst)
    if not inst or not inst:IsA("GuiObject") or not inst.Visible then
        return false
    end
    local p = inst
    while p do
        if p:IsA("GuiObject") and not p.Visible then
            return false
        end
        if p:IsA("ScreenGui") and not p.Enabled then
            return false
        end
        p = p.Parent
    end
    return true
end

--- First FindFirstChild can hit a hidden template; prefer any *shown* instance with this name.
local function playerGuiDescendantShown(name)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        return false
    end
    for _, d in ipairs(pg:GetDescendants()) do
        if d.Name == name and d:IsA("GuiObject") and guiObjectShownOnScreen(d) then
            return true
        end
    end
    return false
end

local function getTryReviveRemote()
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local waves = systems and systems:FindFirstChild("Waves")
    return waves and waves:FindFirstChild("TryReviveUnit")
end

local function getEquippedFolder()
    local pg = LP:FindFirstChild("PlayerGui")
    local profile = pg and pg:FindFirstChild("Profile")
    return profile and profile:FindFirstChild("Equipped")
end

local function unitModelForEquippedSlot(slot)
    local units = workspace:FindFirstChild("Units")
    if not units then
        return nil
    end
    for _, m in ipairs(units:GetChildren()) do
        if m:IsA("Model") and m:GetAttribute("OwnerName") == LP.Name then
            local ref = m:FindFirstChild("DataRef")
            if ref and ref:IsA("ObjectValue") and ref.Value == slot then
                return m
            end
        end
    end
    return nil
end

--- Matches server revive rule: only when no live spawned unit for that Equipped folder (DataRef + Humanoid.Health).
local function isEquippedSlotDeadForRevive(slot)
    if not slot or not slot.Parent then
        return false
    end
    local model = unitModelForEquippedSlot(slot)
    if not model then
        if workspace:GetAttribute("RoundStarted") ~= true then
            return false
        end
        return true
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then
        return true
    end
    return hum.Health <= 0
end

--- Fires TryReviveUnit only for equipped slots whose unit is dead or not spawned (during an active round).
local function fireReviveAllSlots()
    local ev = getTryReviveRemote()
    if not ev or not ev:IsA("RemoteEvent") then
        return false
    end
    local eq = getEquippedFolder()
    if not eq then
        return false
    end
    local any = false
    for _, slot in ipairs(eq:GetChildren()) do
        if isEquippedSlotDeadForRevive(slot) then
            any = true
            pcall(function()
                ev:FireServer(slot)
            end)
        end
    end
    return any
end

local function getVoteRemote()
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local voting = systems and systems:FindFirstChild("Voting")
    local ev = voting and voting:FindFirstChild("Vote")
    if ev and ev:IsA("RemoteEvent") then
        return ev
    end
    return nil
end

local function roundEndGuiButtonVisible(buttonName)
    return playerGuiDescendantShown(buttonName)
end

--- Same as RoundEnd UI: Voting:Vote after intermission (Next = next stage/map, Retry = restart stage).
local function getWavesReadyRemote()
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local waves = systems and systems:FindFirstChild("Waves")
    local r = waves and waves:FindFirstChild("Ready")
    if r and r:IsA("RemoteEvent") then
        return r
    end
    return nil
end

--- Only when the map Ready control is actually shown (not just intermission).
local function mapReadyWanted()
    if LP:GetAttribute("Ready") == true then
        return false
    end
    return playerGuiDescendantShown("ReadyButton")
end

local function fireMapReady()
    if not mapReadyWanted() then
        return false
    end
    local ev = getWavesReadyRemote()
    if not ev then
        return false
    end
    pcall(function()
        ev:FireServer()
    end)
    return true
end

local function fireRoundEndVote(wantNext, wantRetry)
    if not wantNext and not wantRetry then
        return
    end
    local ev = getVoteRemote()
    if not ev then
        return
    end
    local nextShown = wantNext and roundEndGuiButtonVisible("NextStageButton")
    local restartShown = wantRetry and roundEndGuiButtonVisible("RestartButton")
    if nextShown then
        pcall(function()
            ev:FireServer("Next")
        end)
        return
    end
    if restartShown then
        pcall(function()
            ev:FireServer("Retry")
        end)
        return
    end
    -- Voting is open but our GUI probe missed (duplicate names, clipping). Solo rounds can clear the timer fast.
    local timerActive = ReplicatedStorage:GetAttribute("RoundEndTimer") ~= nil
    if not timerActive then
        return
    end
    if wantRetry and not wantNext then
        pcall(function()
            ev:FireServer("Retry")
        end)
        return
    end
    if wantNext and not wantRetry then
        pcall(function()
            ev:FireServer("Next")
        end)
        return
    end
    if wantNext and wantRetry then
        pcall(function()
            ev:FireServer("Next")
        end)
    end
end

local function getRoot()
    local ch = LP.Character
    return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function findChestPrompt(part)
    if not part or not part:IsDescendantOf(workspace) then
        return nil
    end
    return part:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local _warnedNoFirePrompt
local function fireProximityPromptExec(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return false
    end
    local hold = prompt.HoldDuration
    pcall(function()
        prompt.HoldDuration = 0
    end)
    local ok = false
    if typeof(fireproximityprompt) == "function" then
        ok = select(1, pcall(fireproximityprompt, prompt))
    end
    if not ok and getgenv then
        local g = getgenv()
        if g and typeof(g.fireproximityprompt) == "function" then
            ok = select(1, pcall(g.fireproximityprompt, prompt))
        end
    end
    pcall(function()
        prompt.HoldDuration = hold
    end)
    if not ok and not _warnedNoFirePrompt then
        _warnedNoFirePrompt = true
        warn("[AutoBonusChests] fireproximityprompt missing — using E fallback.")
    end
    return ok
end

--- Wait until the local player finishes the prompt (hold E / interact). Fallback if executor cannot fire.
local CHEST_WAIT_SEC = 60

local function waitForChestInteract(prompt, timeoutSec)
    timeoutSec = timeoutSec or CHEST_WAIT_SEC
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
        return false
    end
    if not prompt.Enabled then
        return true
    end
    local done = false
    local c1 = prompt.Triggered:Connect(function(player)
        if player == LP then
            done = true
        end
    end)
    local c2 = prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
        if not prompt.Enabled then
            done = true
        end
    end)
    local t0 = os.clock()
    while not done and prompt.Parent and (os.clock() - t0) < timeoutSec do
        task.wait(0.05)
    end
    pcall(function() c1:Disconnect() end)
    pcall(function() c2:Disconnect() end)
    return done
end

local function moveToPrompt(root, part, prompt)
    local attach = prompt.Parent
    local pos
    if attach and attach:IsA("Attachment") then
        pos = attach.WorldPosition
    else
        pos = part.Position
    end
    local maxDist = (prompt.MaxActivationDistance > 0 and prompt.MaxActivationDistance) or 8
    local offset = (root.Position - pos).Unit * (maxDist * 0.65)
    if offset.Magnitude < 0.1 then
        offset = Vector3.new(0, 0, maxDist * 0.65)
    end
    root.CFrame = CFrame.new(pos + offset)
end

--- progressCb(i, total, msg) optional — e.g. update hint while waiting for E.
local function collectAllChests(progressCb)
    local root = getRoot()
    if not root then
        return 0, "No character"
    end

    local opened = 0
    local parts = CollectionService:GetTagged("BonusChestPart")
    table.sort(parts, function(a, b)
        return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
    end)

    local n = #parts
    for i, part in ipairs(parts) do
        local prompt = findChestPrompt(part)
        if prompt and prompt.Parent and prompt.Enabled then
            pcall(moveToPrompt, root, part, prompt)
            task.wait(0.12)
            if progressCb then
                progressCb(i, n, ("Chest %d/%d — fireproximityprompt…"):format(i, n))
            end
            fireProximityPromptExec(prompt)
            task.wait(0.7)
            if prompt.Enabled then
                if progressCb then
                    progressCb(i, n, ("Chest %d/%d — press E or waiting…"):format(i, n))
                end
                if not waitForChestInteract(prompt, CHEST_WAIT_SEC) then
                    return opened, "Timed out on chest (try executor fireproximityprompt)"
                end
            end
            opened = opened + 1
            task.wait(0.2)
        end
    end

    return opened, nil
end

