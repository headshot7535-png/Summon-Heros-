        return findStartButtonInScreenGui(sgui)
    end
    for _, sgui in ipairs(pg:GetDescendants()) do
        if sgui:IsA("ScreenGui") and sgui ~= preferScreenGui then
            local b = trySg(sgui)
            if b then
                return b
            end
        end
    end
    return nil
end

local function getVisibleMapLists()
    local now = os.clock()
