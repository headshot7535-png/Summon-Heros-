function restartShopRefreshLobbyHopLoop()
    G.shopRefreshHop = G.shopRefreshHop + 1
    local g = G.shopRefreshHop
    local on = extraRefs.shopRefreshLobbyToggleRef and extraRefs.shopRefreshLobbyToggleRef.Get and extraRefs.shopRefreshLobbyToggleRef.Get() == true
    if getgenv and type(getgenv().BonusChestAutoLobbyOnShopRefresh) == "boolean" then
        on = getgenv().BonusChestAutoLobbyOnShopRefresh == true
    end
    if not on then
        return
    end
    local seed0, sec0 = getShopUnitBundleRefreshState()
    G.lastShopRefreshSeed = (type(seed0) == "number") and seed0 or G.lastShopRefreshSeed
    G.lastShopRefreshRemain = (type(sec0) == "number") and sec0 or G.lastShopRefreshRemain
    spawnTracked(function()
        while g == G.shopRefreshHop and bonusChestUiAlive(UI_RUN_GEN) do
            local enabledNow = extraRefs.shopRefreshLobbyToggleRef and extraRefs.shopRefreshLobbyToggleRef.Get and extraRefs.shopRefreshLobbyToggleRef.Get() == true
            if getgenv and type(getgenv().BonusChestAutoLobbyOnShopRefresh) == "boolean" then
                enabledNow = getgenv().BonusChestAutoLobbyOnShopRefresh == true
            end
            if not enabledNow then
                break
            end
            local seed, sec = getShopUnitBundleRefreshState()
            local refreshed = false
            if type(seed) == "number" then
                if type(G.lastShopRefreshSeed) == "number" and seed ~= G.lastShopRefreshSeed then
                    refreshed = true
                end
                G.lastShopRefreshSeed = seed
            end
            if not refreshed and type(sec) == "number" and type(G.lastShopRefreshRemain) == "number" then
                if G.lastShopRefreshRemain <= 3 and sec > (G.lastShopRefreshRemain + 5) then
                    refreshed = true
                end
            end
            if type(sec) == "number" then
                G.lastShopRefreshRemain = sec
            end
            if refreshed then
                local now = os.clock()
                if now - (G.lastShopLobbyHopAt or 0) > 8 then
                    G.lastShopLobbyHopAt = now
                    local ok, why = tryTeleportBackToLobbyOnce()
                    if ok then
                        Win:Status("Shop refreshed: returning to lobby")
                    else
                        Win:Status(("Shop refreshed: lobby return failed (%s)"):format(tostring(why)))
                    end
                end
            end
            task.wait(1.5)
        end
    end)
end

