-- Rule-aligned generation token: new run cancels old run cleanly.
_G.ScriptGen = (_G.ScriptGen or 0) + 1
local SCRIPT_GEN = _G.ScriptGen

local _persist = (getgenv and getgenv()) or _G
if type(_persist._BonusChestCleanupAll) == "function" then
    pcall(_persist._BonusChestCleanupAll, "reexec")
end

local _conns, _threads = {}, {}
local function addConn(c)
    if c then _conns[#_conns + 1] = c end
    return c
end
local function addThread(t)
    if t then _threads[#_threads + 1] = t end
    return t
end
local function connectTracked(signal, fn)
    if not signal or type(fn) ~= "function" then
        return nil
    end
    return addConn(signal:Connect(fn))
end
local function spawnTracked(fn)
    if type(fn) ~= "function" then
        return nil
    end
    return addThread(task.spawn(function()
        if SCRIPT_GEN ~= _G.ScriptGen then
            return
        end
        fn()
    end))
end
local function cleanupAll()
    for _, c in ipairs(_conns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    for _, t in ipairs(_threads) do
        pcall(function()
            task.cancel(t)
        end)
    end
    _conns, _threads = {}, {}
end
_persist._BonusChestCleanupAll = cleanupAll

--- Re-exec: singleton state in getgenv/_G so connections and loops do not stack (major lag after teleport re-runs).
local function bonusChestPersist()
    return _persist
end

local function bonusChestBumpRearmGen()
    local st = bonusChestPersist()
    st._BonusChestRearmGen = (st._BonusChestRearmGen or 0) + 1
    return st._BonusChestRearmGen
end

--- Bumped once per NexusLib UI load; previous run's auto task.spawn loops exit (G.* is local per chunk — re-exec could not cancel them).
local function bonusChestBumpUiGen()
    local st = bonusChestPersist()
    st._SummonHeroesUiGen = (st._SummonHeroesUiGen or 0) + 1
    return st._SummonHeroesUiGen
end

local function bonusChestUiAlive(capturedGen)
    return capturedGen == ((bonusChestPersist()._SummonHeroesUiGen or 0))
end

-- ── Auto re-exec (same idea as AniPixels): arm queue on load, re-queue on TeleportState.RequestedByServer, sync _G.BonusChest_AutoRejoin, periodic re-arm when toggled back on
local function syncBonusChestRejoinFlag()
    pcall(function()
        if _G then
            _G.BonusChest_AutoRejoin = (saved.queueOnTeleport ~= false)
                and not (getgenv and getgenv().BonusChestNoQueue == true)
        end
    end)
end

local function armBonusChestQueue()
    syncBonusChestRejoinFlag()
    if getgenv and getgenv().BonusChestNoQueue == true then
        return false, "skipped"
    end
    if saved.queueOnTeleport == false then
        return false, "off"
    end
    return tryQueueOnTeleport("arm")
end

pcall(function()
    if _G and _G.BonusChest_AutoRejoin and saved.queueOnTeleport == false then
        saved.queueOnTeleport = true
        saveConfig(saved)
    end
end)
syncBonusChestRejoinFlag()

pcall(function()
    local st = bonusChestPersist()
    if st._BonusChestOnTeleportConn then
        pcall(function()
            st._BonusChestOnTeleportConn:Disconnect()
        end)
        st._BonusChestOnTeleportConn = nil
    end
    st._BonusChestOnTeleportConn = addConn(LP.OnTeleport:Connect(function(teleportState)
        if teleportState ~= Enum.TeleportState.RequestedByServer then
            return
        end
        syncBonusChestRejoinFlag()
        if saved.queueOnTeleport == false then
            return
        end
        if getgenv and getgenv().BonusChestNoQueue == true then
            return
        end
        tryQueueOnTeleport("teleport_requested")
    end))
end)

do
    local rearmGen = bonusChestBumpRearmGen()
    spawnTracked(function()
        local wasOn = saved.queueOnTeleport ~= false
            and not (getgenv and getgenv().BonusChestNoQueue == true)
        while rearmGen == (bonusChestPersist()._BonusChestRearmGen or 0) do
            task.wait(2)
            syncBonusChestRejoinFlag()
            local on = saved.queueOnTeleport ~= false and not (getgenv and getgenv().BonusChestNoQueue == true)
            if on and not wasOn then
                pcall(armBonusChestQueue)
            end
            wasOn = on
        end
    end)
end

