local function normalizeStatTierToken(s)
    if type(s) ~= "string" then
        return ""
    end
    local t = string.upper((s:match("^%s*(.-)%s*$") or "")):gsub("%s+", "")
    if t == "OFF" or t == "" then
        return "OFF"
    end
    -- Common aliases.
    if t == "E" then
        t = "EX"
    elseif t == "S+" then
        t = "SS"
    elseif t == "X+" then
        t = "EX"
    end
    return t
end

local function statLetterScore(letter, curves)
    if type(letter) ~= "string" or #letter == 0 then
        return 0
    end
    local L = normalizeStatTierToken(letter)
    if L == "OFF" then
        return 0
    end
    if curves and type(curves.LetterMultiplier) == "function" then
        local ok, v = pcall(function()
            return curves:LetterMultiplier(L)
        end)
        if ok and type(v) == "number" then
            return v
        end
    end
    local fallback = {
        D = 1, C = 2, B = 3, A = 4, S = 5, SS = 6, X = 7, EX = 8,
    }
    if fallback[L] then
        return fallback[L]
    end
    local k = string.upper(string.sub(L, 1, 1))
    return LETTER_RANK_SCORE[k] or 0
end

local function getUnitStatLetter(unit, key)
    if not unit then
        return nil
    end
    local function isRankString(s)
        if type(s) ~= "string" or #s == 0 then
            return false
        end
        local tok = normalizeStatTierToken(s)
        return tok ~= "" and tok ~= "OFF"
    end
    local v = unit:GetAttribute(key)
    if isRankString(v) then
        return v
    end
    local alt = unit:GetAttribute(key .. "Letter") or unit:GetAttribute(key .. "Rank")
    if isRankString(alt) then
        return alt
    end
    return nil
end

local getStatRerollUnlockedKeys

local function statRerollReachedTargetTier(unit, lockedList, targetTier)
    local target = normalizeStatTierToken(targetTier)
    if target == "OFF" or not unit then
        return false
    end
    local curves = getCurvesModule()
    local targetScore = statLetterScore(target, curves)
    if targetScore <= 0 then
        return false
    end
    local unlocked = getStatRerollUnlockedKeys(lockedList or {})
    if #unlocked == 0 then
        return false
    end
    for _, key in ipairs(unlocked) do
        local letter = getUnitStatLetter(unit, key) or ""
        if statLetterScore(letter, curves) < targetScore then
            return false
        end
    end
    return true
end

local function buildStatRerollLockedList(lockAtk, lockHp, lockCd, lockSpd)
    local locked = {}
    if lockAtk then
        locked[#locked + 1] = "Attack"
    end
