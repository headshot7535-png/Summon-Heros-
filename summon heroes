statRerollToggleRef = T:Toggle("Auto stat reroll", "Repeats until max rolls or toggle off", saved.autoStatReroll, function(on)
    statRerollGen = statRerollGen + 1
    local g = statRerollGen
    if on then
        task.spawn(function()
            local rolls = 0
            while g == statRerollGen do
                local maxR = tonumber(statRerollMaxRollsInputRef.Get()) or saved.statRerollMaxRolls
                if getgenv and type(getgenv().BonusChestStatRerollMaxRolls) == "number" then
                    maxR = getgenv().BonusChestStatRerollMaxRolls
                end
                maxR = math.max(0, math.floor(maxR or 0))
                if maxR > 0 and rolls >= maxR then
                    statRerollToggleRef.Set(false)
                    Win:Notify("Stat reroll", "Max rolls reached.", 3, "success")
                    persistAll()
                    break
                end
                local _, mode = statRerollModeDropdownRef.Get()
                local modeStr = (mode == "better" and "better") or "always"
                local ok, why = tryStatRerollOnce({
                    unitNameFilter = statRerollUnitInputRef.Get(),
                    lockAtk = statRerollLockAtkToggleRef.Get(),
                    lockHp = statRerollLockHpToggleRef.Get(),
                    lockCd = statRerollLockCdToggleRef.Get(),
                    lockSpd = statRerollLockSpdToggleRef.Get(),
                    mode = modeStr,
                })
                if ok then
                    rolls = rolls + 1
                end
                if why == "no_module" or why == "no_unit" or why == "no_match" or why == "all_locked" then
                    Win:Status("Stat reroll: " .. tostring(why))
                    task.wait(2)
                elseif why == "buy_failed" then
                    task.wait(1.5)
                else
                    local d = tonumber(statRerollDelayInputRef.Get()) or saved.statRerollDelaySec
                    d = math.clamp(d, 0, 60)
                    task.wait(d > 0 and d or 0.05)
                end
            end
        end)
    else
        Win:Status("Auto stat reroll OFF")
    end
    persistAll()
end)

