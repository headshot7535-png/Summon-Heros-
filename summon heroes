        { "statRerollLockSpeed",    "bool" },
        { "statRerollMode",         "enum:always:better" },
        { "statRerollStopTier",     "enum:OFF:D:C:B:A:S:SS:X:EX" },
        { "statRerollMaxRolls",     "intMin:0" },
        { "statRerollDelaySec",     "floatMin:0" },
        { "autoTraitReroll",        "bool" },
        { "traitRerollUnitName",    "str" },
        { "traitRerollGoals",       "str" },
        { "traitRerollMode",        "enum:until_goal:always_apply" },
        { "traitRerollMaxRolls",    "intMin:0" },
        { "traitRerollDelaySec",    "floatMin:0" },
        { "traitRerollSkipAnim",    "bool" },
        { "autoClaimAchievements",  "bool" },
        { "autoClaimDaily",         "bool" },
        { "claimQuestsIntervalSec", "intMin:5" },
        { "autoClaimUnitDex",       "bool" },
        { "claimUnitDexIntervalSec","intMin:10" },
        { "autoClaimLeaderboard",   "bool" },
        { "claimLeaderboardIntervalSec", "intMin:10" },
        { "queueStateListener",     "bool" },
        { "playerWalkSpeed",        "intClamp:0:300" },
        { "playerInfiniteJump",     "bool" },
        { "playerAntiAfk",          "bool" },
        { "playerNoclip",           "bool" },
        { "playerGodMode",          "bool" },
    }

    for _, fd in ipairs(FIELDS) do
        local key, rule = fd[1], fd[2]
        local v = data[key]
        if rule == "bool" then
            if type(v) == "boolean" then defaults[key] = v end
        elseif rule == "str" then
            if type(v) == "string" then defaults[key] = v end
        elseif rule == "strNonEmpty" then
            if type(v) == "string" and #v > 0 then defaults[key] = v end
        elseif rule == "floatMin:0" then
            if type(v) == "number" and v >= 0 then defaults[key] = v end
        else
            -- numeric rules: intMin:n | intClamp:lo:hi | enum:a:b:...
            local ruleType = rule:match("^([^:]+)")
            if ruleType == "intMin" then
                local minVal = tonumber(rule:match(":(.+)$")) or 0
                if type(v) == "number" and v >= minVal then
                    defaults[key] = math.floor(v)
                end
            elseif ruleType == "intClamp" then
                local lo, hi = rule:match(":(%d+):(%d+)")
                lo, hi = tonumber(lo), tonumber(hi)
                if type(v) == "number" and lo and hi then
                    defaults[key] = math.clamp(math.floor(v), lo, hi)
                end
            elseif ruleType == "enum" then
                local allowed = {}
                for part in rule:gmatch(":([^:]+)") do
                    allowed[part] = true
                end
                if type(v) == "string" and allowed[v] then
                    defaults[key] = v
                end
            end
        end
    end

    return defaults
end

local function saveConfig(payload)
    if not writefile then
        return
    end
    local ok, json = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not ok or type(json) ~= "string" then
        return
    end
    pcall(writefile, CONFIG_FILE, json)
end

