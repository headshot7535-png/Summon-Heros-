local function bindQueueStateRemotesOnce()
    if extraRefs._queueStateBound then
        return true
    end
    local enabled = (saved.queueStateListener ~= false)
    if extraRefs.queueStateListenerToggleRef and type(extraRefs.queueStateListenerToggleRef.Get) == "function" then
        enabled = extraRefs.queueStateListenerToggleRef.Get() == true
    end
    if not enabled then
        return false
    end
    local showEv = findRemoteAnywhere("ShowTeleportOverlay")
    local leftEv = findRemoteAnywhere("LeftQueue")
    local bound = false
    extraRefs._queueStateConns = extraRefs._queueStateConns or {}
    if showEv and showEv:IsA("RemoteEvent") then
        local c1 = connectTracked(showEv.OnClientEvent, function(a, b, c, d)
            local label = tostring(a or "Teleport")
            local map = tostring(b or "")
            local stage = tostring(c or "")
            local mode = tostring(d or "")
            if #map > 0 and #stage > 0 then
                Win:Status(("[Queue] %s → %s stage %s %s"):format(label, map, stage, mode ~= "" and ("(" .. mode .. ")") or ""))
            else
                Win:Status("[Queue] " .. label)
            end
        end)
        if c1 then
            extraRefs._queueStateConns[#extraRefs._queueStateConns + 1] = c1
        end
        bound = true
    end
    if leftEv and leftEv:IsA("RemoteEvent") then
        local c2 = connectTracked(leftEv.OnClientEvent, function()
            Win:Status("[Queue] Left queue / returned to lobby")
        end)
        if c2 then
            extraRefs._queueStateConns[#extraRefs._queueStateConns + 1] = c2
        end
        bound = true
    end
    extraRefs._queueStateBound = bound
    return bound
end

local function startQueueStateListenerLoop()
    if extraRefs._queueStateLoopStarted then
        return
    end
