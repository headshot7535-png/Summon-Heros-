function getSummonHeroesDiscordInvite()
    local g = getgenv and getgenv()
    local url = g and g.BonusChestDiscordInvite
    if type(url) == "string" then
        url = (url:match("^%s*(.-)%s*$") or "")
        if #url > 0 then
            return url
        end
    end
    return "https://discord.gg/ErGUHtVK"
end

function copySummonHeroesDiscordInvite()
    local url = getSummonHeroesDiscordInvite()
    local fns = {
        setclipboard,
        toclipboard,
        (getgenv and getgenv().setclipboard),
        (getgenv and getgenv().toclipboard),
    }
    for _, fn in ipairs(fns) do
        if type(fn) == "function" then
            local ok = pcall(fn, url)
            if ok then
                return true, url
            end
        end
    end
    return false, url
end

function openSummonHeroesDiscordInvite()
    local url = getSummonHeroesDiscordInvite()
    if syn and type(syn.openUrl) == "function" then
        local ok = pcall(syn.openUrl, url)
        if ok then
            return true, url
        end
    end
    local ok = pcall(function()
        return game:GetService("GuiService"):OpenBrowserWindow(url)
    end)
    return ok, url
end

