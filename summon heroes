refreshStageWatcher = function()
    stageGen = stageGen + 1
    local g = stageGen
    local function anyStageAuto()
        return (nextStageToggleRef and nextStageToggleRef.Get())
            or (retryStageToggleRef and retryStageToggleRef.Get())
    end
    if not anyStageAuto() then
        return
    end
    task.spawn(function()
        while g == stageGen do
            if not anyStageAuto() then
                break
            end
            local timerOn = ReplicatedStorage:GetAttribute("RoundEndTimer") ~= nil
            local uiNext = roundEndNextUiVisible()
            local uiRetry = roundEndRetryUiVisible()
            if timerOn or uiNext or uiRetry then
                fireRoundEndVote(
                    nextStageToggleRef and nextStageToggleRef.Get(),
                    retryStageToggleRef and retryStageToggleRef.Get()
                )
            end
            task.wait(0.35)
        end
    end)
end

