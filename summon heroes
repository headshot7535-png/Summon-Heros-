-- Returns true if a map row's text content matches the given mapKey.
-- Matches: exact Name, normalised Name, display-name ↔ WaveData key, or substring.
local function mapRowMatchesKey(row, mapKey)
    if not row or not mapKey then return false end
    -- 1. Exact Name match (old behaviour, kept for future-proofing)
    if row.Name == mapKey then return true end
    -- 2. Normalised Name match
    local nk = normaliseMapName(mapKey)
    if normaliseMapName(row.Name) == nk then return true end
    -- 3. Match by text label content inside the row
    local txt = normaliseMapName(rowDisplayText(row))
    if #txt > 0 and (txt:find(nk, 1, true) or nk:find(txt, 1, true)) then return true end
    -- 4. Reverse: display text of row matches a known alias of mapKey
    local alias = DISPLAY_TO_WAVE_KEY[txt]
    if alias and normaliseMapName(alias) == nk then return true end
    return false
end

local function findStoryMapRow(mapKey)
    for _, mapList in ipairs(getVisibleMapLists()) do
        local holder = mapListInnerList(mapList)
        if holder then
            local rows = getHolderMapRows(holder)
            -- First: fast exact-name hit
            local exact = holder:FindFirstChild(mapKey)
            if exact and exact:IsA("GuiObject") and exact:GetAttribute("StageNum") == nil then
                return mapList, exact
            end
            -- Second: iterate all rows and match by name OR text content
            for _, row in ipairs(rows) do
                if row:GetAttribute("StageNum") == nil then
                    if mapRowMatchesKey(row, mapKey) then
                        return mapList, row
                    end
                end
            end
            -- Third: if only 1 non-UI child exists and map key is any story map, return it
            -- (handles ComingSoonMap placeholder being the only visible row)
            local validRows = {}
            for _, row in ipairs(rows) do
                if row:GetAttribute("StageNum") == nil then
                    validRows[#validRows + 1] = row
                end
            end
            if #validRows == 1 then
                -- Only one row: treat it as the target map (player opened right UI)
                return mapList, validRows[1]
            end
        end
    end
    return nil, nil
end

