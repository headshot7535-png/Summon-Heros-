local function restartQuestAutoClaimLoop()
    questClaimGen = questClaimGen + 1
    local g = questClaimGen
    local wantA = claimAchievementsToggleRef and claimAchievementsToggleRef.Get()
    local wantD = claimDailyToggleRef and claimDailyToggleRef.Get()
    if not wantA and not wantD then
        Win:Status("Auto quest claim OFF")
        return
    end
    task.spawn(function()
        while g == questClaimGen do
            local a = claimAchievementsToggleRef and claimAchievementsToggleRef.Get()
            local d = claimDailyToggleRef and claimDailyToggleRef.Get()
            if not a and not d then
                break
            end
            local ok, why = tryClaimAchievementsAndDailyOnce({
                achievements = a,
                daily = d,
            })
            if why == "no_api" then
                Win:Status("Quests: no Quests/QuestEvent API")
            end
            local w = tonumber(claimQuestsIntervalInputRef.Get()) or saved.claimQuestsIntervalSec
            if getgenv and type(getgenv().BonusChestClaimQuestsIntervalSec) == "number" then
                w = getgenv().BonusChestClaimQuestsIntervalSec
            end
            w = math.clamp(math.floor(w or 45), 5, 600)
            task.wait(w)
        end
    end)
end

