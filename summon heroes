function hrpWithinStudsOfQueueSlot(slotModel, maxDist)
    maxDist = maxDist or QUEUE_TELEPORT_SKIP_DIST
    if not slotModel then
        return false
    end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false
    end
    local hp = hrp.Position
    local best = math.huge
    local main = getQueueVisualMainPart(slotModel)
    if main then
        best = math.min(best, (hp - main.Position).Magnitude)
    end
    local door = slotModel:FindFirstChild("Door", true)
    if door and door:IsA("BasePart") then
        best = math.min(best, (hp - door.Position).Magnitude)
    end
    if slotModel:IsA("Model") then
        pcall(function()
            local piv = slotModel:GetPivot().Position
            best = math.min(best, (hp - piv).Magnitude)
            local ext = slotModel:GetExtentsSize()
            local halfDiag = 0.5 * math.sqrt(ext.X * ext.X + ext.Y * ext.Y + ext.Z * ext.Z)
            maxDist = math.max(maxDist, math.min(halfDiag + 24, 52))
        end)
    end
    if best == math.huge then
        return false
    end
    return best <= maxDist
end

function queueTeleportSkipDistance()
    if getgenv and type(getgenv().BonusChestQueueTeleportSkipDist) == "number" then
        return math.clamp(getgenv().BonusChestQueueTeleportSkipDist, 8, 120)
    end
    return QUEUE_TELEPORT_SKIP_DIST
end

function queuePadOwnedByOther(slotModel)
    if not slotModel or not slotModel.Parent then
        return false, nil
    end
    local owner = slotModel:GetAttribute("OwnerName")
    if type(owner) == "string" then
        owner = (owner:match("^%s*(.-)%s*$") or "")
        if #owner > 0 and owner ~= LP.Name then
            return true, owner
        end
    end
    return false, nil
end

function queuePadHasOtherPlayersNear(slotModel, radius)
    if not slotModel or not slotModel.Parent then
        return false, nil
    end
    radius = tonumber(radius) or 14
    local main = getQueueVisualMainPart(slotModel)
    local door = slotModel:FindFirstChild("Door", true)
    if not main and not (door and door:IsA("BasePart")) then
        return false, nil
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                local hp = hrp.Position
                local near = false
                if main and (hp - main.Position).Magnitude <= radius then
                    near = true
                end
                if not near and door and door:IsA("BasePart") and (hp - door.Position).Magnitude <= radius then
                    near = true
                end
                if near then
                    return true, plr.Name
                end
            end
        end
    end
    return false, nil
end

function queuePadBusyByOther(slotModel, checkNearby)
    local owned, owner = queuePadOwnedByOther(slotModel)
    if owned then
        return true, owner
    end
    if checkNearby ~= false then
        local near, who = queuePadHasOtherPlayersNear(slotModel, getgenv and getgenv().BonusChestQueueBusyRadius)
        if near then
            return true, who
        end
    end
    return false, nil
end

function chooseQueueSlotWithHop(preferredSlot, wantStory)
    local hopEnabled = (saved.smartQueueSlotHop ~= false) and not (getgenv and getgenv().BonusChestDisableSlotHop == true)
    if not hopEnabled then
        return preferredSlot
    end
    local queues = getLobbyQueuesFolder()
    if not queues then
        return preferredSlot
    end
    local seen, candidates = {}, {}
    local function add(slot)
        if slot and slot:IsA("Model") and slot.Parent and not seen[slot] then
            seen[slot] = true
            candidates[#candidates + 1] = slot
        end
    end
    add(preferredSlot)
    for _, slot in ipairs(queues:GetChildren()) do
        local main = getQueueVisualMainPart(slot)
        if main then
            local hueOk = (wantStory and visualMainLooksLikeStoryQueue(main))
                or ((wantStory == false) and visualMainLooksLikeDungeonQueue(main))
            if hueOk then
                add(slot)
            end
        end
    end
    for _, slot in ipairs(queues:GetChildren()) do
        add(slot)
    end
    local firstBusyWho = nil
    for _, slot in ipairs(candidates) do
        local busy, who = queuePadBusyByOther(slot, true)
        if not busy then
            return slot
        end
        if not firstBusyWho and who then
            firstBusyWho = who
        end
    end
    return nil, firstBusyWho
end

--- Lobby: Story pad (opens map UI) → map + stage → queue Door/Main → LaunchQueue / SetQueue → Start.
function tryAutoStartStoryOnce(mapKey, stageNum)
    if type(mapKey) ~= "string" or #mapKey == 0 then
        return false, "bad_map"
    end
    stageNum = tonumber(stageNum)
    if not stageNum or stageNum < 1 then
        return false, "bad_stage"
    end
    stageNum = math.floor(stageNum)

    -- Direct pad path: TP to blue queue Visual.Main → SetQueue + LaunchQueue (no map UI needed).
    -- Used when: BonusChestStoryDirectPadSetQueueLaunch = true, OR pad model found by hue
    -- (which means we know where the queue is and the ProximityPrompt approach isn't needed).
    local _directPadForced = getgenv and getgenv().BonusChestStoryDirectPadSetQueueLaunch == true
    local _directPadModel  = getStoryQueuePadModelByLobbyColor()
    if _directPadForced or _directPadModel then
        local pad = _directPadModel or resolveStoryQueueLobbySlotInstance()
        local busyWho
        pad, busyWho = chooseQueueSlotWithHop(pad, true)
        if not pad then
            return false, "pad_busy:" .. tostring(busyWho or "unknown")
        end
        if teleportHrpToQueuePadMainWithOffset(pad) then
            task.wait(0.24)
            if trySetQueueThenLaunchQueueForPadModel(pad, mapKey, stageNum) then
                return true, nil
            end
            return false, "queue_remote_fail"
        end
        return false, "no_hrp"
    end

    local slotInst, busyWho = chooseQueueSlotWithHop(resolveStoryQueueLobbySlotInstance(), true)
    if not slotInst then
        return false, "pad_busy:" .. tostring(busyWho or "unknown")
    end

    if getgenv and getgenv().BonusChestFireBlueQueuePadPrompt == true then
        local pr = select(1, findQueuePadPromptAndModelByHue(true))
        if pr then
            tryTeleportHumanoidToQueuePadPrompt(pr)
            task.wait(0.35)
        end
    end

    -- Always fire the pad ProximityPrompt first so the MapSelect UI populates its rows.
    -- The game dynamically adds map rows only after the pad interaction — searching before this always fails.
    if not (getgenv and getgenv().BonusChestStoryTeleportToPad == false) then
        -- Quick TP to pad position so prompt fires reliably
        tryTeleportToStoryPad(false)
        task.wait(0.18)
    end

    -- Check if map UI is already open with rows populated
    local mapList, mapEntry = findStoryMapRow(mapKey)

    -- If not found, fire the ProximityPrompt to open / refresh the MapSelect UI
    if not (mapList and mapEntry) then
        if not (getgenv and getgenv().BonusChestStoryPadFirePrompt == false) then
            if tryStoryPadTeleportAndFirePromptOpenMapUi() then
                -- Wait for rows to be dynamically added by the game
                local uiWait = 2.2
                if getgenv and type(getgenv().BonusChestStoryPadPromptUiWait) == "number" then
                    uiWait = getgenv().BonusChestStoryPadPromptUiWait
                end
                local deadline = os.clock() + math.clamp(uiWait, 0.5, 5)
                repeat
                    task.wait(0.1)
                    mapList, mapEntry = findStoryMapRow(mapKey)
                until (mapList and mapEntry) or os.clock() >= deadline
            end
        end
    end

    -- Second TP attempt with forced snap in case first didn't register
    if not (mapList and mapEntry) and not (getgenv and getgenv().BonusChestStoryTeleportToPad == false) then
        tryTeleportToStoryPad(true)
        task.wait(0.25)
        mapList, mapEntry = findStoryMapRow(mapKey)
    end
    if mapList and mapEntry then
        local sg = screenGuiAncestor(mapList)
        local mapLock = mapEntry:FindFirstChild("Container", true)
        mapLock = mapLock and mapLock:FindFirstChild("LockState")
        if mapLock and mapLock:IsA("GuiObject") and mapLock.Visible then
            return false, "map_locked"
        end
        guiActivate(mapEntry:IsA("GuiButton") and mapEntry or mapEntry:FindFirstDescendantWhichIsA("GuiButton"))
        task.wait(0.22)

        local stageList = findStageListInScreenGui(sg)
        if not stageList then
            return false, "no_stage_list"
        end
        local sList = stageList:FindFirstChild("List")
        if not sList then
            return false, "no_stage_list"
        end
        local stageEntry
        for _, ch in ipairs(sList:GetChildren()) do
            local cont = ch:FindFirstChild("Container")
            local lab = cont and cont:FindFirstChild("Label")
            if lab and lab:IsA("TextLabel") and stageListLabelMatches(lab.Text, stageNum) then
                stageEntry = ch
                break
            end
        end
        if not stageEntry then
            return false, "no_stage"
        end
        local stLock = stageEntry:FindFirstChild("Container") and stageEntry.Container:FindFirstChild("LockState")
        if stLock and stLock:IsA("GuiObject") and stLock.Visible then
            return false, "stage_locked"
        end
        guiActivate(stageEntry:IsA("GuiButton") and stageEntry or stageEntry:FindFirstDescendantWhichIsA("GuiButton"))
        task.wait(0.2)

        -- Party queue / LaunchQueue expects you at the slot (Visual + Door), not another pad snap after GUI picks.
        if slotInst and not (getgenv and getgenv().BonusChestStorySkipQueueDoorTeleport == true) then
            local reTp = getgenv and getgenv().BonusChestStoryQueueReteleport == true
            local every = getgenv and getgenv().BonusChestStoryQueueTeleportEveryTick == true
            local doTp = false
            if not storyQueueLobbyTeleportUsed then
                doTp = true
            elseif every then
                doTp = true
            elseif reTp and not hrpWithinStudsOfQueueSlot(slotInst, queueTeleportSkipDistance()) then
                doTp = true
            end
            if doTp then
                local ch = LP.Character
                if ch and ch:FindFirstChild("HumanoidRootPart") then
                    tryTeleportToQueueVisualMain(slotInst)
                    task.wait(0.15)
                    tryTeleportToQueueSlotDoor(slotInst)
                    task.wait(0.28)
                    storyQueueLobbyTeleportUsed = true
                end
            end
        end

        -- RequestEnterQueue must succeed before LaunchQueue/SetQueue will be honoured.
        -- We are already at the Door from the teleport above, so the magnitude check passes.
        if slotInst then
            local reqEv = resolveRequestEnterQueueRemote()
            if reqEv then
                local okR, suc, _, eMsg = pcall(function()
                    return reqEv:InvokeServer(slotInst)
                end)
                if okR then
                    print("[SH] Story RequestEnterQueue ->", suc, eMsg)
                else
                    print("[SH] Story RequestEnterQueue pcall error:", suc)
                end
                task.wait(0.3)
            end
        end

        local remoteQueueOk = false
        if slotInst then
            local launchEv = resolveLaunchQueueRemote()
            local fired = false
            if launchEv and not (getgenv and getgenv().BonusChestSkipLaunchQueue == true) then
                fired = select(1, pcall(function()
                    launchEv:FireServer(slotInst)
                end))
                if fired then
                    task.wait(0.12)
                end
            end
            if not fired then
                local setEv = resolveSetQueueRemote()
                if setEv then
                    local okFire
                    if setEv:IsA("RemoteFunction") then
                        okFire = select(1, pcall(function()
                            setEv:InvokeServer(slotInst, mapKey, stageNum)
                        end))
                    else
                        okFire = select(1, pcall(function()
                            setEv:FireServer(slotInst, mapKey, stageNum)
                        end))
                    end
                    if okFire then
                        task.wait(0.12)
                        remoteQueueOk = true
                    end
                end
            else
                remoteQueueOk = true
            end
        end

        -- Queue module in dump handles LaunchQueue server-side directly; skip extra UI click when remote launch already succeeded.
        local preferRemote = not (getgenv and getgenv().BonusChestPreferRemoteLaunch == false)
        if preferRemote and remoteQueueOk then
            return true, nil
        end

        -- Search preferred ScreenGui first, then all PlayerGui ScreenGuis
        local startBtn = findStartButtonInPlayerGui(sg)
        if not startBtn then
            return remoteQueueOk and true or false, remoteQueueOk and nil or "no_start"
        end
        guiActivate(startBtn)
        task.wait(0.12)
        guiActivate(startBtn)
        task.wait(0.12)
        guiActivate(startBtn)  -- triple-click for reliability
        return true, nil
    end

    return false, "no_ui"
end

