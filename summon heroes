local _uiPerf = {
    startButtonByScreenGuiCache = setmetatable({}, { __mode = "k" }),
    startButtonCacheSec = 0.2,
    visibleMapListsCache = { t = 0, list = nil },
    mapListCacheSec = 0.2,
    holderMapRowsCache = setmetatable({}, { __mode = "k" }),
    holderMapRowsCacheSec = 0.2,
    normaliseMapNameCache = {},
    rowDisplayTextCache = setmetatable({}, { __mode = "k" }),
    rowDisplayTextCacheSec = 0.35,
    stageListByScreenGuiCache = setmetatable({}, { __mode = "k" }),
    stageListCacheSec = 0.2,
}
local function findStartButtonInScreenGui(sg)
    if not sg or not sg:IsA("ScreenGui") then
        return nil
    end
    local now = os.clock()
    local cache = _uiPerf.startButtonByScreenGuiCache[sg]
    if cache and (now - cache.t) < _uiPerf.startButtonCacheSec then
        if cache.v and cache.v.Parent and cache.v:IsA("GuiButton") and guiObjectShownOnScreen(cache.v) then
            return cache.v
        end
        if cache.miss then
            return nil
        end
    end
    local fallback = nil
    for _, d in ipairs(sg:GetDescendants()) do
        if d:IsA("GuiButton") and guiObjectShownOnScreen(d) then
            if d.Name == "StartButton" then
                _uiPerf.startButtonByScreenGuiCache[sg] = { t = now, v = d, miss = false }
                return d
            end
            if not fallback then
                local n = string.lower(d.Name)
                if n == "start" or n == "startbtn" or n == "startbutton" or string.sub(n, 1, 5) == "start" then
                    fallback = d
                elseif d:IsA("TextButton") and textLooksLikeStart(d.Text) then
                    fallback = d
                elseif (d:IsA("ImageButton") or d:IsA("TextButton")) and guiButtonDisplaysStart(d) then
                    fallback = d
                end
            end
        end
    end
    _uiPerf.startButtonByScreenGuiCache[sg] = { t = now, v = fallback, miss = (fallback == nil) }
    return fallback
end

--- Map list lives in one ScreenGui; party "Start" may be in another enabled gui — search all.
local function findStartButtonInPlayerGui(preferScreenGui)
    if preferScreenGui then
        local b = findStartButtonInScreenGui(preferScreenGui)
        if b then
            return b
