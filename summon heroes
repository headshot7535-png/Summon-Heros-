--- Clicks map row → stage row → Start when the story map-select UI is visible (Queue:SetQueue path).
local function tryAutoStartStoryOnce(mapKey, stageNum)
    if type(mapKey) ~= "string" or #mapKey == 0 then
        return false, "bad_map"
    end
    stageNum = tonumber(stageNum)
    if not stageNum or stageNum < 1 then
        return false, "bad_stage"
    end
    stageNum = math.floor(stageNum)

    local mapList, mapEntry = findStoryMapRow(mapKey)
    if not mapList or not mapEntry then
        return false, "no_ui"
    end
    local sg = screenGuiAncestor(mapList)
    local mapLock = mapEntry:FindFirstChild("Container", true)
    mapLock = mapLock and mapLock:FindFirstChild("LockState")
    if mapLock and mapLock:IsA("GuiObject") and mapLock.Visible then
        return false, "map_locked"
    end
    guiActivate(mapEntry:IsA("GuiButton") and mapEntry or mapEntry:FindFirstDescendantWhichIsA("GuiButton"))
    task.wait(0.22)

    local stageList = findStageListInScreenGui(sg)
    if not stageList then
        return false, "no_stage_list"
    end
    local sList = stageList:FindFirstChild("List")
    if not sList then
        return false, "no_stage_list"
    end
    local stageEntry
    for _, ch in ipairs(sList:GetChildren()) do
        local cont = ch:FindFirstChild("Container")
        local lab = cont and cont:FindFirstChild("Label")
        if lab and lab:IsA("TextLabel") and stageListLabelMatches(lab.Text, stageNum) then
            stageEntry = ch
            break
        end
    end
    if not stageEntry then
        return false, "no_stage"
    end
    local stLock = stageEntry:FindFirstChild("Container") and stageEntry.Container:FindFirstChild("LockState")
    if stLock and stLock:IsA("GuiObject") and stLock.Visible then
        return false, "stage_locked"
    end
    guiActivate(stageEntry:IsA("GuiButton") and stageEntry or stageEntry:FindFirstDescendantWhichIsA("GuiButton"))
    task.wait(0.2)

    local startBtn = findStartButtonInScreenGui(sg)
    if not startBtn then
        return false, "no_start"
    end
    guiActivate(startBtn)
    task.wait(0.08)
    guiActivate(startBtn)
    return true, nil
end

