local function tryEnumerateQuestModuleClaims(m, category)
    local getters
    if category == "achievement" then
        getters = { "GetClaimableAchievements", "GetReadyAchievements", "GetCompletedAchievements" }
    else
        getters = { "GetClaimableDaily", "GetDailyQuests", "GetClaimableDailyQuests", "GetReadyDaily" }
    end
    local claimFns = { "ClaimAchievement", "ClaimQuest", "Claim", "RedeemAchievement", "ClaimDaily" }
    for _, g in ipairs(getters) do
        if type(m[g]) == "function" then
            local ok, list = pcall(function()
                return m[g](m, LP)
            end)
            if ok and type(list) == "table" then
                for _, entry in ipairs(list) do
                    local id = type(entry) == "string" and entry
                    if type(entry) == "table" then
                        id = entry.Id or entry.ID or entry.Name or entry.Key
                    end
                    if type(id) == "string" and #id > 0 then
                        for _, cf in ipairs(claimFns) do
                            if type(m[cf]) == "function" then
                                pcall(function()
                                    m[cf](m, LP, id)
                                end)
                                pcall(function()
                                    m[cf](m, LP, category == "achievement" and "Achievements" or "Daily", id)
                                end)
                            end
                        end
                    end
                end
                return true
            end
        end
    end
    return false
end

