--- Stand on Visual.Main (blue/red Neon marker) then nudge — some games use Main.Touched instead of Door.
--- CFrame-snap HRP onto Visual.Main. firetouchinterest is client-only — not used.
function tryTeleportToQueueVisualMain(slotModel)
    local main = getQueueVisualMainPart(slotModel)
    if not main then return false end
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos = main.Position
