--- NexusLib Toggle:Get() returns boolean false when OFF. In Lua, `ref and ref.Get() or saved.x` wrongly replaces false with saved.x — OFF never persists. Use this instead.
local function persistToggleBool(ref, defaultWhenNoRef)
    if ref and type(ref.Get) == "function" then
        return ref.Get() == true
    end
    if type(defaultWhenNoRef) == "boolean" then
        return defaultWhenNoRef
    end
    return false
end

