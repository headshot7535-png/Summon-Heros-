end

local function statLetterScore(letter, curves)
    if type(letter) ~= "string" or #letter == 0 then
        return 0
    end
    local L = letter:match("^%s*(%S+)%s*$") or letter
    if curves and type(curves.LetterMultiplier) == "function" then
        local ok, v = pcall(function()
            return curves:LetterMultiplier(L)
        end)
        if ok and type(v) == "number" then
            return v
        end
    end
    local k = string.upper(string.sub(L, 1, 1))
    return LETTER_RANK_SCORE[k] or 0
end

local function getUnitStatLetter(unit, key)
    if not unit then
        return nil
    end
    local function isRankString(s)
        if type(s) ~= "string" or #s == 0 then
            return false
        end
        local k = string.upper(string.sub(s, 1, 1))
        return LETTER_RANK_SCORE[k] ~= nil
    end
    local v = unit:GetAttribute(key)
    if isRankString(v) then
        return v
    end
    local alt = unit:GetAttribute(key .. "Letter") or unit:GetAttribute(key .. "Rank")
    if isRankString(alt) then
        return alt
    end
    return nil
end

local function buildStatRerollLockedList(lockAtk, lockHp, lockCd, lockSpd)
    local locked = {}
    if lockAtk then
        locked[#locked + 1] = "Attack"
    end
    if lockHp then
        locked[#locked + 1] = "Health"
    end
    if lockCd then
        locked[#locked + 1] = "Cooldown"
    end
    if lockSpd then
        locked[#locked + 1] = "Speed"
    end
    return locked
end

local function getStatRerollUnlockedKeys(lockedList)
    local skip = {}
    for _, k in ipairs(lockedList) do
        skip[k] = true
    end
    local out = {}
    for _, k in ipairs(STAT_REROLL_KEYS) do
        if not skip[k] then
            out[#out + 1] = k
        end
    end
    return out
end

--- nameFilter: substring (case-insensitive) or empty for highest-level equipped, else inventory.
local function resolveStatRerollUnit(nameFilter)
    local profile = getPlayerProfileFolder()
    if not profile then
        return nil
    end
    local equipped = profile:FindFirstChild("Equipped")
    local invRoot = profile:FindFirstChild("Inventory")
    local invUnits = invRoot and invRoot:FindFirstChild("Units")
    local filterTrim = type(nameFilter) == "string" and (nameFilter:match("^%s*(.-)%s*$") or "") or ""
    local wantFilter = #filterTrim > 0

    local function matchName(inst)
        if not wantFilter then
            return true
        end
        local nm = string.lower(inst.Name)
        local ft = string.lower(filterTrim)
        return nm == ft or string.find(nm, ft, 1, true) ~= nil
    end

    local best = nil
    local function consider(u)
        if not u or not u.Parent then
            return
        end
        if not matchName(u) then
            return
        end
        if not best or unitAttrLevel(u) > unitAttrLevel(best) then
            best = u
        end
    end

    if equipped then
        for _, u in ipairs(equipped:GetChildren()) do
            consider(u)
        end
    end
    if invUnits then
        for _, u in ipairs(invUnits:GetChildren()) do
            consider(u)
        end
    end
    if best then
        return best
    end
    if wantFilter then
        return nil
    end

    if equipped then
        local eq = {}
        for _, u in ipairs(equipped:GetChildren()) do
            eq[#eq + 1] = u
        end
        table.sort(eq, function(a, b)
            return unitAttrLevel(a) > unitAttrLevel(b)
        end)
        if eq[1] then
            return eq[1]
        end
    end
    if invUnits then
        local inv = {}
        for _, u in ipairs(invUnits:GetChildren()) do
            if not unitIsLocked(u) then
                inv[#inv + 1] = u
            end
        end
        table.sort(inv, function(a, b)
            return unitAttrLevel(a) > unitAttrLevel(b)
        end)
        if inv[1] then
            return inv[1]
        end
    end
    return nil
end

--- Returns ok, reason where reason: used_new, kept, buy_failed, no_module, no_unit, no_match, all_locked
local function tryStatRerollOnce(opts)
    opts = opts or {}
    local upgrades = getUnitUpgradesModule()
    if not upgrades or type(upgrades.BuyStatReroll) ~= "function" or type(upgrades.RerollAction) ~= "function" then
        return false, "no_module"
    end

    local nameFilter = opts.unitNameFilter
    if getgenv and type(getgenv().BonusChestStatRerollUnit) == "string" and #getgenv().BonusChestStatRerollUnit > 0 then
        nameFilter = getgenv().BonusChestStatRerollUnit
    end

    local unit = resolveStatRerollUnit(nameFilter)
    if not unit then
        local trim = type(nameFilter) == "string" and (nameFilter:match("^%s*(.-)%s*$") or "") or ""
        if #trim > 0 then
            return false, "no_match"
        end
        return false, "no_unit"
    end

    local locked = buildStatRerollLockedList(opts.lockAtk, opts.lockHp, opts.lockCd, opts.lockSpd)
    local unlocked = getStatRerollUnlockedKeys(locked)
    if #unlocked == 0 then
        return false, "all_locked"
    end

    local curves = getCurvesModule()
    local mode = opts.mode or "always"
    if getgenv and (getgenv().BonusChestStatRerollMode == "better" or getgenv().BonusChestStatRerollMode == "always") then
        mode = getgenv().BonusChestStatRerollMode
    end

    local function sumUnlockedLetters(letterTable, useUnit)
        local s = 0
        for _, k in ipairs(unlocked) do
            local L
            if useUnit then
                L = getUnitStatLetter(unit, k)
            else
                L = letterTable and letterTable[k]
            end
            s = s + statLetterScore(L, curves)
        end
        return s
    end

    local oldSum = sumUnlockedLetters(nil, true)

    local newStats
    local okBuy, ret = pcall(function()
        return upgrades:BuyStatReroll(LP, unit, locked)
    end)
    if not okBuy or ret == nil or type(ret) ~= "table" then
        return false, "buy_failed"
    end
    newStats = ret

    local useNew = true
    if mode == "better" then
        local newSum = sumUnlockedLetters(newStats, false)
        useNew = newSum > oldSum
    end

    pcall(function()
        upgrades:RerollAction(LP, useNew and "UseNew" or "KeepCurrent")
    end)

    return true, useNew and "used_new" or "kept"
end

