local function entryPriceAndCurrency(entry)
    if type(entry) ~= "table" then
        return nil, nil
    end
    if entry.CoinPrice ~= nil then
        return entry.CoinPrice, "Coins"
    end
    if entry.GemsPrice ~= nil then
        return entry.GemsPrice, "Gems"
    end
    if entry.PVPTokensPrice ~= nil then
        return entry.PVPTokensPrice, "PVPTokens"
    end
    if entry.GoldPrice ~= nil then
        return entry.GoldPrice, "Coins"
    end
    local p = entry.Price or entry.Cost
    local ct = entry.CurrencyType or entry.Currency
    if type(ct) == "string" then
        local c = string.lower(ct)
        if string.find(c, "gem", 1, true) then
            return p, "Gems"
        end
        if string.find(c, "pvp", 1, true) or string.find(c, "token", 1, true) then
            return p, "PVPTokens"
        end
        if string.find(c, "gold", 1, true) or c == "coins" or c == "coin" then
            return p, "Coins"
        end
        return p, ct
    end
    return p, nil
end

local function rotatingShopCandidateKeys(shopKey)
    local base = type(shopKey) == "string" and (shopKey:match("^%s*(.-)%s*$") or "") or ""
    if #base == 0 then
        return { "ItemShop", "PvPShop" }
    end
    local out, seen = {}, {}
    local function add(k)
        if type(k) ~= "string" then
            return
        end
        k = (k:match("^%s*(.-)%s*$") or "")
        if #k == 0 or seen[k] then
            return
        end
        seen[k] = true
        out[#out + 1] = k
    end
    add(base)
    local low = string.lower(base)
    if low == "itemshop" or low == "regularshop" or low == "shop" then
        add("ItemShop")
        add("PvPShop")
    elseif low == "pvpshop" or low == "pvp" then
        add("PvPShop")
        add("ItemShop")
    else
        if string.find(low, "pvp", 1, true) then
            add("PvPShop")
            add("ItemShop")
        else
            add("ItemShop")
            add("PvPShop")
        end
    end
    return out
end

--- buyAny: true = * filter. nameSet: lower-case ItemName -> true
local function parseRotatingShopFilter(text)
    if type(text) ~= "string" then
        return false, nil, "empty"
    end
    local s = (text:match("^%s*(.-)%s*$") or "")
    if #s == 0 then
        return false, nil, "empty"
    end
    if s == "*" then
        return true, {}, nil
    end
    local set = {}
    for part in string.gmatch(s, "[^,]+") do
        local k = (part:match("^%s*(.-)%s*$") or "")
        if #k > 0 then
            set[string.lower(k)] = true
        end
    end
    if next(set) == nil then
        return false, nil, "empty"
    end
    return false, set, nil
end

local function rotatingShopNameWanted(nameSet, iname)
    if type(iname) ~= "string" or type(nameSet) ~= "table" then
        return false
    end
    local low = string.lower(iname)
    if nameSet[low] == true then
        return true
    end
    for k, on in pairs(nameSet) do
        if on == true and type(k) == "string" and #k > 0 then
            if string.find(low, k, 1, true) or string.find(k, low, 1, true) then
                return true
            end
        end
    end
    return false
end

local function resolveRotatingShopBuyDelay(delaySec)
    local d = tonumber(delaySec)
    if not d then
        d = tonumber(saved and saved.rotatingShopBuyDelaySec) or 1.05
    end
    if getgenv and type(getgenv().BonusChestRotatingShopBuyDelaySec) == "number" then
        d = getgenv().BonusChestRotatingShopBuyDelaySec
    end
    return math.clamp(tonumber(d) or 1.05, 0.1, 1.5)
end

--- Buys matching slots (1..n); ~1s between fires (matches in-game buy cooldown). Returns count, reason.
local function tryRotatingShopAutoBuy(shopKey, filterText, buyDelaySec)
    if type(shopKey) ~= "string" or #shopKey == 0 then
        return 0, "bad_shop"
    end
    local buyAny, nameSet, ferr = parseRotatingShopFilter(filterText)
    if ferr == "empty" then
        return 0, "no_filter"
    end
    local rotMod, buyEv = resolveRotatingShopsBuy()
    if not buyEv then
        return 0, "no_remote"
    end
    local candidateKeys = rotatingShopCandidateKeys(shopKey)
    local buyDelay = resolveRotatingShopBuyDelay(buyDelaySec)
    if not rotMod or type(rotMod) ~= "table" then
        if not buyAny then
            return 0, "no_module_filter"
        end
        local slots = nil
        if getgenv and type(getgenv().BonusChestRotatingShopSlots) == "table" then
            slots = getgenv().BonusChestRotatingShopSlots
        end
        local bought = 0
        if type(slots) == "table" and #slots > 0 then
            for _, si in ipairs(slots) do
                local i = tonumber(si)
                if i and i >= 1 and i <= 32 then
                    fireShopBuy(buyEv, candidateKeys[1] or shopKey, math.floor(i))
                    bought = bought + 1
                    task.wait(buyDelay)
                end
            end
        else
            for i = 1, 16 do
                fireShopBuy(buyEv, candidateKeys[1] or shopKey, i)
                bought = bought + 1
                task.wait(buyDelay)
            end
        end
        if bought > 0 then
            return bought, "blind"
        end
        return 0, "nothing"
    end
    local effectiveShopKey = candidateKeys[1] or shopKey
    local items = nil
    for _, k in ipairs(candidateKeys) do
        local t = rotatingShopGetItems(rotMod, k)
        if type(t) == "table" and next(t) ~= nil then
            items = t
            effectiveShopKey = k
            break
        end
    end
    if type(items) ~= "table" then
        return 0, "no_items"
    end
    local cur = getCurrencyModule()
    local bought = 0
    for i = 1, 16 do
        local entry = items[i] or items[tostring(i)]
        if entry then
            local iname = entry.ItemName or entry.Name or entry.Id
            local want = buyAny
            if not want and type(iname) == "string" then
                want = rotatingShopNameWanted(nameSet, iname)
            end
            if want and type(iname) == "string" and rotatingShopHasStock(rotMod, effectiveShopKey, i) then
                local price, cType = entryPriceAndCurrency(entry)
                local canBuy = true
                if price ~= nil and cType ~= nil then
                    canBuy = currencyCanAfford(cur, LP, price, cType)
                end
                if canBuy then
                    fireShopBuy(buyEv, effectiveShopKey, i)
                    bought = bought + 1
                    task.wait(buyDelay)
                end
            end
        end
    end
    if bought > 0 then
        return bought, nil
    end
    return 0, "nothing"
end

