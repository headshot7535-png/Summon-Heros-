local function entryPriceAndCurrency(entry)
    if type(entry) ~= "table" then
        return nil, nil
    end
    if entry.CoinPrice ~= nil then
        return entry.CoinPrice, "Coins"
    end
    if entry.GemsPrice ~= nil then
        return entry.GemsPrice, "Gems"
    end
    if entry.PVPTokensPrice ~= nil then
        return entry.PVPTokensPrice, "PVPTokens"
    end
    if entry.GoldPrice ~= nil then
        return entry.GoldPrice, "Coins"
    end
    local p = entry.Price or entry.Cost
    local ct = entry.CurrencyType or entry.Currency
    if type(ct) == "string" then
        local c = string.lower(ct)
        if string.find(c, "gem", 1, true) then
            return p, "Gems"
        end
        if string.find(c, "pvp", 1, true) or string.find(c, "token", 1, true) then
            return p, "PVPTokens"
        end
        if string.find(c, "gold", 1, true) or c == "coins" or c == "coin" then
            return p, "Coins"
        end
        return p, ct
    end
    return p, nil
end

--- buyAny: true = * filter. nameSet: lower-case ItemName -> true
local function parseRotatingShopFilter(text)
    if type(text) ~= "string" then
        return false, nil, "empty"
    end
    local s = (text:match("^%s*(.-)%s*$") or "")
    if #s == 0 then
        return false, nil, "empty"
    end
    if s == "*" then
        return true, {}, nil
    end
    local set = {}
    for part in string.gmatch(s, "[^,]+") do
        local k = (part:match("^%s*(.-)%s*$") or "")
        if #k > 0 then
            set[string.lower(k)] = true
        end
    end
    if next(set) == nil then
        return false, nil, "empty"
    end
    return false, set, nil
end

--- Buys matching slots (1..n); ~1s between fires (matches in-game buy cooldown). Returns count, reason.
local function tryRotatingShopAutoBuy(shopKey, filterText)
    if type(shopKey) ~= "string" or #shopKey == 0 then
        return 0, "bad_shop"
    end
    local buyAny, nameSet, ferr = parseRotatingShopFilter(filterText)
    if ferr == "empty" then
        return 0, "no_filter"
    end
    local rotMod, buyEv = resolveRotatingShopsBuy()
    if not buyEv then
        return 0, "no_remote"
    end
    if not rotMod or type(rotMod) ~= "table" then
        return 0, "no_module"
    end
    local items = rotatingShopGetItems(rotMod, shopKey)
    if type(items) ~= "table" then
        return 0, "no_items"
    end
    local cur = getCurrencyModule()
    local bought = 0
    for i = 1, 16 do
        local entry = items[i] or items[tostring(i)]
        if entry then
            local iname = entry.ItemName or entry.Name or entry.Id
            local want = buyAny
            if not want and type(iname) == "string" then
                want = nameSet[string.lower(iname)] == true
            end
            if want and type(iname) == "string" and rotatingShopHasStock(rotMod, shopKey, i) then
                local price, cType = entryPriceAndCurrency(entry)
                local canBuy = true
                if price ~= nil and cType ~= nil then
                    canBuy = currencyCanAfford(cur, LP, price, cType)
                end
                if canBuy then
                    fireShopBuy(buyEv, shopKey, i)
                    bought = bought + 1
                    task.wait(1.05)
                end
            end
        end
    end
    if bought > 0 then
        return bought, nil
    end
    return 0, "nothing"
end

