        end
    else
        local names = {
            "ClaimAllDaily",
            "ClaimDailyRewards",
            "RedeemAllDaily",
            "AutoClaimDaily",
            "TryClaimAllDaily",
        }
        for _, n in ipairs(names) do
            if pcallQuestMethod(m, n) then
