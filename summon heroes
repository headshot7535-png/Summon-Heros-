                return q.GetTimeToNextDailyRefresh(q)
            end)
            if ok and tonumber(out) then
                sec = tonumber(out)
            end
        end
    end
    if sec == nil then
        local okNow, now = pcall(function()
            return workspace:GetServerTimeNow()
        end)
        if okNow and type(now) == "number" and now == now then
