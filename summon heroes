local _warnedNoFirePrompt
local function fireProximityPromptExec(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return false
    end
    local hold = prompt.HoldDuration
    pcall(function()
        prompt.HoldDuration = 0
    end)
    local ok = false
    if typeof(fireproximityprompt) == "function" then
        ok = select(1, pcall(fireproximityprompt, prompt))
    end
    if not ok and getgenv then
        local g = getgenv()
        if g and typeof(g.fireproximityprompt) == "function" then
            ok = select(1, pcall(g.fireproximityprompt, prompt))
        end
    end
    pcall(function()
        prompt.HoldDuration = hold
    end)
    if not ok and not _warnedNoFirePrompt then
        _warnedNoFirePrompt = true
        warn("[AutoBonusChests] fireproximityprompt missing — using E fallback.")
    end
    return ok
end

--- Wait until the local player finishes the prompt (hold E / interact). Fallback if executor cannot fire.
local CHEST_WAIT_SEC = 60

local function waitForChestInteract(prompt, timeoutSec)
    timeoutSec = timeoutSec or CHEST_WAIT_SEC
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
        return false
    end
    if not prompt.Enabled then
        return true
    end
    local done = false
    local c1 = prompt.Triggered:Connect(function(player)
        if player == LP then
            done = true
        end
    end)
    local c2 = prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
        if not prompt.Enabled then
            done = true
        end
    end)
    local t0 = os.clock()
    while not done and prompt.Parent and (os.clock() - t0) < timeoutSec do
        task.wait(0.05)
    end
    pcall(function() c1:Disconnect() end)
    pcall(function() c2:Disconnect() end)
    return done
end

local function moveToPrompt(root, part, prompt)
    local attach = prompt.Parent
    local pos
    if attach and attach:IsA("Attachment") then
        pos = attach.WorldPosition
    else
        pos = part.Position
    end
    local maxDist = (prompt.MaxActivationDistance > 0 and prompt.MaxActivationDistance) or 8
    local offset = (root.Position - pos).Unit * (maxDist * 0.65)
    if offset.Magnitude < 0.1 then
        offset = Vector3.new(0, 0, maxDist * 0.65)
    end
    root.CFrame = CFrame.new(pos + offset)
end

--- progressCb(i, total, msg) optional — e.g. update hint while waiting for E.
local function collectAllChests(progressCb)
    local root = getRoot()
    if not root then
        return 0, "No character"
    end

    local opened = 0
    local parts = CollectionService:GetTagged("BonusChestPart")
    table.sort(parts, function(a, b)
        return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
    end)

    local n = #parts
    for i, part in ipairs(parts) do
        local prompt = findChestPrompt(part)
        if prompt and prompt.Parent and prompt.Enabled then
            pcall(moveToPrompt, root, part, prompt)
            task.wait(0.12)
            if progressCb then
                progressCb(i, n, ("Chest %d/%d — fireproximityprompt…"):format(i, n))
            end
            fireProximityPromptExec(prompt)
            task.wait(0.7)
            if prompt.Enabled then
                if progressCb then
                    progressCb(i, n, ("Chest %d/%d — press E or waiting…"):format(i, n))
                end
                if not waitForChestInteract(prompt, CHEST_WAIT_SEC) then
                    return opened, "Timed out on chest (try executor fireproximityprompt)"
                end
            end
            opened = opened + 1
            task.wait(0.2)
        end
    end

    return opened, nil
end

