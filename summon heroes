local function fireRoundEndVote(wantNext, wantRetry)
    if not wantNext and not wantRetry then
        return
    end
    local ev = getVoteRemote()
    if not ev then
        return
    end
    local nVis, rVis = getRoundEndVoteButtonsVisible()
    local nextShown = wantNext and nVis
    local restartShown = wantRetry and rVis
    local timerActive = ReplicatedStorage:GetAttribute("RoundEndTimer") ~= nil

    local function tryActivate(which)
        local b = findShownGuiButtonForRoundEnd(which)
        if b then
            pcall(function()
                b:Activate()
            end)
        end
    end

    if nextShown then
        pcall(function()
            ev:FireServer("Next")
        end)
        tryActivate("next")
        return
    end
    if restartShown then
        pcall(function()
            ev:FireServer("Retry")
        end)
        tryActivate("retry")
        return
    end
    -- No matching UI; still try Vote if server voting window is open (timer), or blind retry when only one toggle.
    if not timerActive then
        return
    end
    if wantRetry and not wantNext then
        pcall(function()
            ev:FireServer("Retry")
        end)
        return
    end
    if wantNext and not wantRetry then
        pcall(function()
            ev:FireServer("Next")
        end)
        return
    end
    if wantNext and wantRetry then
        pcall(function()
            ev:FireServer("Next")
        end)
    end
end

