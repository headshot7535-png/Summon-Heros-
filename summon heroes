--- Matches "Stage 3", "STAGE  3", labels with extra spaces/case.
local function stageListLabelMatches(labText, wantStage)
    wantStage = tonumber(wantStage)
    if not wantStage then
        return false
    end
    local raw = tostring(labText or "")
    if raw == ("Stage " .. tostring(wantStage)) then
        return true
    end
    local low = string.lower(raw:gsub("%s+", " "))
    local n = tonumber(string.match(low, "^stage%s*(%d+)$"))
        or tonumber(string.match(low, "stage%s*(%d+)"))
    return n == wantStage
end

