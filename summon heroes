--[[
  Bonus chest auto-collect + NexusLib UI.
  Game: parts tagged "BonusChestPart", ProximityPrompt under Attachment (BonusChests system).

  NexusLib: optional getgenv().NexusLibPath, then readfile("NexusLib.lua"), then GitHub URLs.
  Chests: script teleports in range; you complete each ProximityPrompt (E / hold) before the next.

  Re-run after server / lobby: uses queue_on_teleport (TeleportService). Optional:
    getgenv().BonusChestScriptUrl = "https://..."  -- override script URL
    getgenv().BonusChestNoQueue = true             -- skip queue_on_teleport
  Closing Roblox or losing connection cannot be hooked from Lua — use executor auto-execute.

  Settings file: BonusChests_config.json — toggles + queueOnTeleport. Ready: Systems.Waves.Ready. Vote: Systems.Voting.Vote.
]]

local HttpService = game:GetService("HttpService")
local CONFIG_FILE = (getgenv and type(getgenv().BonusChestConfigPath) == "string" and getgenv().BonusChestConfigPath)
    or "BonusChests_config.json"

local function loadConfig()
    local defaults = {
        autoCollect = false,
        queueOnTeleport = true,
        autoRevive = false,
        autoPlayNextMap = false,
        autoRetryStage = false,
        autoReadyUp = false,
    }
    if not readfile then
        return defaults
    end
    local ok, raw = pcall(readfile, CONFIG_FILE)
    if not ok or type(raw) ~= "string" or #raw < 3 then
        return defaults
    end
    local ok2, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not ok2 or type(data) ~= "table" then
        return defaults
    end
    if type(data.autoCollect) == "boolean" then
        defaults.autoCollect = data.autoCollect
    end
    if type(data.queueOnTeleport) == "boolean" then
        defaults.queueOnTeleport = data.queueOnTeleport
    end
    if type(data.autoRevive) == "boolean" then
        defaults.autoRevive = data.autoRevive
    end
    if type(data.autoPlayNextMap) == "boolean" then
        defaults.autoPlayNextMap = data.autoPlayNextMap
    end
    if type(data.autoRetryStage) == "boolean" then
        defaults.autoRetryStage = data.autoRetryStage
    end
    if type(data.autoReadyUp) == "boolean" then
        defaults.autoReadyUp = data.autoReadyUp
    end
    return defaults
end

local function saveConfig(payload)
    if not writefile then
        return
    end
    local ok, json = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not ok or type(json) ~= "string" then
        return
    end
    pcall(writefile, CONFIG_FILE, json)
end

local saved = loadConfig()

-- Sync teleport opt-out with saved preference before queue_on_teleport runs.
if getgenv then
    if saved.queueOnTeleport then
        getgenv().BonusChestNoQueue = nil
    else
        getgenv().BonusChestNoQueue = true
    end
end

local NEXUSLIB_URLS = {
    "https://raw.githubusercontent.com/headshot7535-png/Nexuslib/main/Nexuslib",
    "https://raw.githubusercontent.com/headshot7535-png/Nexuslib/main/Nexuslib.lua",
}

local NexusLib
if readfile and pcall then
    local tryPaths = {}
    if getgenv and type(getgenv().NexusLibPath) == "string" then
        tryPaths[#tryPaths + 1] = getgenv().NexusLibPath
    end
    tryPaths[#tryPaths + 1] = "NexusLib.lua"
    for _, path in ipairs(tryPaths) do
        local ok, data = pcall(readfile, path)
        if ok and type(data) == "string" and #data > 500 then
            local lok, chunk = pcall(loadstring, data)
            if lok and chunk then
                local okm, mod = pcall(chunk)
                if okm and mod and type(mod) == "table" and mod.Window then
                    NexusLib = mod
                    break
                end
            end
        end
    end
end
if not NexusLib then
    for _, url in ipairs(NEXUSLIB_URLS) do
        local ok, mod = pcall(function()
            local src = game:HttpGet(url, true)
            if src and #src > 100 then
                return loadstring(src)()
            end
        end)
        if ok and type(mod) == "table" and mod.Window then
            NexusLib = mod
            break
        end
    end
end
if not NexusLib or not NexusLib.Window then
    error("[AutoBonusChests] NexusLib failed to load. Check HttpService / readfile.")
end

-- Raw script (Summon-Heros); re-fetched after teleport / server hop.
local SCRIPT_SOURCE_URL = (getgenv and getgenv().BonusChestScriptUrl)
    or "https://raw.githubusercontent.com/headshot7535-png/Summon-Heros-/main/summon%20heroes"

local function tryQueueOnTeleport()
    if getgenv and getgenv().BonusChestNoQueue == true then
        return false, "skipped"
    end
    local code = string.format("loadstring(game:HttpGet(%q, true))()", SCRIPT_SOURCE_URL)
    local candidates = {
        typeof(queue_on_teleport) == "function" and queue_on_teleport,
        typeof(syn) == "table" and syn.queue_on_teleport,
        typeof(fluxus) == "table" and fluxus.queue_on_teleport,
        typeof(Krnl) == "table" and Krnl.queue_on_teleport,
        getgenv and typeof(getgenv().queue_on_teleport) == "function" and getgenv().queue_on_teleport,
    }
    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            local ok = pcall(fn, code)
            if ok then
                return true, nil
            end
        end
    end
    return false, "no_api"
end

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer

local function getTryReviveRemote()
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local waves = systems and systems:FindFirstChild("Waves")
    return waves and waves:FindFirstChild("TryReviveUnit")
end

local function getEquippedFolder()
    local pg = LP:FindFirstChild("PlayerGui")
    local profile = pg and pg:FindFirstChild("Profile")
    return profile and profile:FindFirstChild("Equipped")
end

--- Fires TryReviveUnit for each slot under Profile.Equipped (e.g. DemonHunter). Server ignores invalid / alive units.
local function fireReviveAllSlots()
    local ev = getTryReviveRemote()
    if not ev or not ev:IsA("RemoteEvent") then
        return false
    end
    local eq = getEquippedFolder()
    if not eq then
        return false
    end
    for _, slot in ipairs(eq:GetChildren()) do
        pcall(function()
            ev:FireServer(slot)
        end)
    end
    return true
end

local function getVoteRemote()
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local voting = systems and systems:FindFirstChild("Voting")
    local ev = voting and voting:FindFirstChild("Vote")
    if ev and ev:IsA("RemoteEvent") then
        return ev
    end
    return nil
end

local function roundEndGuiButtonVisible(buttonName)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        return false
    end
    local inst = pg:FindFirstChild(buttonName, true)
    return inst ~= nil and inst:IsA("GuiObject") and inst.Visible
end

--- Same as RoundEnd UI: Voting:Vote after intermission (Next = next stage/map, Retry = restart stage).
local function getWavesReadyRemote()
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local waves = systems and systems:FindFirstChild("Waves")
    local r = waves and waves:FindFirstChild("Ready")
    if r and r:IsA("RemoteEvent") then
        return r
    end
    return nil
end

--- True when map wants a ready press: intermission or Ready HUD visible, and we are not already Ready.
local function mapReadyWanted()
    if LP:GetAttribute("Ready") == true then
        return false
    end
    local waveInfo = ReplicatedStorage:FindFirstChild("WaveInfo")
    if waveInfo and waveInfo:GetAttribute("Intermission") == true then
        return true
    end
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        local btn = pg:FindFirstChild("ReadyButton", true)
        if btn and btn:IsA("GuiObject") and btn.Visible then
            return true
        end
    end
    return false
end

local function fireMapReady()
    if not mapReadyWanted() then
        return false
    end
    local ev = getWavesReadyRemote()
    if not ev then
        return false
    end
    pcall(function()
        ev:FireServer()
    end)
    return true
end

local function fireRoundEndVote(wantNext, wantRetry)
    if not wantNext and not wantRetry then
        return
    end
    local ev = getVoteRemote()
    if not ev then
        return
    end
    local nextVis = roundEndGuiButtonVisible("NextStageButton")
    local restartVis = roundEndGuiButtonVisible("RestartButton")
    if wantNext and nextVis then
        pcall(function()
            ev:FireServer("Next")
        end)
        return
    end
    if wantRetry and restartVis then
        pcall(function()
            ev:FireServer("Retry")
        end)
    end
end

local function getRoot()
    local ch = LP.Character
    return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function findChestPrompt(part)
    if not part or not part:IsDescendantOf(workspace) then
        return nil
    end
    return part:FindFirstChildWhichIsA("ProximityPrompt", true)
end

--- Wait until the local player finishes the prompt (hold E / interact). Does not auto-fire the prompt.
local CHEST_WAIT_SEC = 300

local function waitForChestInteract(prompt, timeoutSec)
    timeoutSec = timeoutSec or CHEST_WAIT_SEC
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
        return false
    end
    if not prompt.Enabled then
        return true
    end
    local done = false
    local c1 = prompt.Triggered:Connect(function(player)
        if player == LP then
            done = true
        end
    end)
    local c2 = prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
        if not prompt.Enabled then
            done = true
        end
    end)
    local t0 = os.clock()
    while not done and prompt.Parent and (os.clock() - t0) < timeoutSec do
        task.wait(0.05)
    end
    pcall(function() c1:Disconnect() end)
    pcall(function() c2:Disconnect() end)
    return done
end

local function moveToPrompt(root, part, prompt)
    local attach = prompt.Parent
    local pos
    if attach and attach:IsA("Attachment") then
        pos = attach.WorldPosition
    else
        pos = part.Position
    end
    local maxDist = (prompt.MaxActivationDistance > 0 and prompt.MaxActivationDistance) or 8
    local offset = (root.Position - pos).Unit * (maxDist * 0.65)
    if offset.Magnitude < 0.1 then
        offset = Vector3.new(0, 0, maxDist * 0.65)
    end
    root.CFrame = CFrame.new(pos + offset)
end

--- progressCb(i, total, msg) optional — e.g. update hint while waiting for E.
local function collectAllChests(progressCb)
    local root = getRoot()
    if not root then
        return 0, "No character"
    end

    local opened = 0
    local parts = CollectionService:GetTagged("BonusChestPart")
    table.sort(parts, function(a, b)
        return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
    end)

    local n = #parts
    for i, part in ipairs(parts) do
        local prompt = findChestPrompt(part)
        if prompt and prompt.Parent and prompt.Enabled then
            pcall(moveToPrompt, root, part, prompt)
            task.wait(0.1)
            if progressCb then
                progressCb(i, n, ("Chest %d/%d — press E to open"):format(i, n))
            end
            local finished = waitForChestInteract(prompt, CHEST_WAIT_SEC)
            if finished then
                opened = opened + 1
                task.wait(0.2)
            else
                return opened, "Timed out waiting for E on chest"
            end
        end
    end

    return opened, nil
end

-- ── NexusLib UI ───────────────────────────────────────────────
local Win = NexusLib:Window({ title = "Bonus Chests", width = 360, height = 620 })

local T = Win:Tab("📦", "Chests")
T:Section("Map chests")
T:Label("BonusChestPart · moves to each chest; you must press E (hold) before the next.")

local hint = T:Label("Ready.")

local function setHint(text)
    hint.Set(text)
end

T:Button("🎯", "Collect all now", "TP to each chest in order — press E to open before next", nil, function()
    Win:Status("Opening chests…")
    setHint("Running…")
    task.spawn(function()
        local n, err = collectAllChests(function(_, _, msg)
            setHint(msg)
        end)
        if err then
            Win:Status(err)
            setHint(err)
            Win:Notify("Chests", err, 4, "warning")
            return
        end
        local msg = string.format("Opened %d chest(s)", n)
        Win:Status(msg)
        setHint(msg)
        Win:Notify("Chests", msg, 3, n > 0 and "success" or "warning")
    end)
end)

T:Section("Automation")

local autoToggleRef
local reviveToggleRef
local readyToggleRef
local nextStageToggleRef
local retryStageToggleRef
local queueToggleRef

local function persistAll()
    saveConfig({
        autoCollect = autoToggleRef and autoToggleRef.Get() or false,
        queueOnTeleport = queueToggleRef and queueToggleRef.Get() or true,
        autoRevive = reviveToggleRef and reviveToggleRef.Get() or false,
        autoReadyUp = readyToggleRef and readyToggleRef.Get() or false,
        autoPlayNextMap = nextStageToggleRef and nextStageToggleRef.Get() or false,
        autoRetryStage = retryStageToggleRef and retryStageToggleRef.Get() or false,
    })
end

local loopGen = 0
local reviveGen = 0
local readyGen = 0
local stageGen = 0

local refreshStageWatcher

autoToggleRef = T:Toggle("Auto collect", "Full route every 2s after E on each chest", saved.autoCollect, function(on)
    loopGen = loopGen + 1
    local myGen = loopGen
    if on then
        Win:Status("Auto chests ON")
        task.spawn(function()
            while myGen == loopGen do
                local n, err = collectAllChests(function(_, _, msg)
                    setHint(msg)
                end)
                if err then
                    setHint(err)
                elseif n > 0 then
                    setHint(("Last pass: %d opened"):format(n))
                    Win:Status(("Auto · last %d"):format(n))
                end
                task.wait(2)
            end
        end)
    else
        Win:Status("Auto chests OFF")
    end
    persistAll()
end)

T:Section("Revive")
T:Label("Waves.TryReviveUnit · all Profile.Equipped slots (uses your revives).")

reviveToggleRef = T:Toggle("Auto revive", "Fire revive on equipped slots every 1.5s", saved.autoRevive, function(on)
    reviveGen = reviveGen + 1
    local myR = reviveGen
    if on then
        task.spawn(function()
            while myR == reviveGen do
                if not fireReviveAllSlots() then
                    Win:Status("Revive: wait for Profile / Waves")
                end
                task.wait(1.5)
            end
        end)
    end
    persistAll()
end)

T:Section("Map ready")
T:Label("Waves.Ready:FireServer() when intermission or Ready button shows (not already Ready).")

readyToggleRef = T:Toggle("Auto ready up", "Checks ~1s · same as Ready in map HUD", saved.autoReadyUp, function(on)
    readyGen = readyGen + 1
    local myReady = readyGen
    if on then
        task.spawn(function()
            while myReady == readyGen do
                fireMapReady()
                task.wait(1)
            end
        end)
    end
    persistAll()
end)

T:Section("Stage vote")
T:Label("Round-end: Systems.Voting.Vote — Next if Play Next visible, else Retry if Restart visible.")

nextStageToggleRef = T:Toggle("Auto play next map / stage", "Votes Next when the round-end screen offers it", saved.autoPlayNextMap, function()
    persistAll()
    if refreshStageWatcher then
        refreshStageWatcher()
    end
end)

retryStageToggleRef = T:Toggle("Auto retry stage", "Votes Retry when Restart is shown (e.g. after a loss)", saved.autoRetryStage, function()
    persistAll()
    if refreshStageWatcher then
        refreshStageWatcher()
    end
end)

refreshStageWatcher = function()
    stageGen = stageGen + 1
    local g = stageGen
    local function anyStageAuto()
        return (nextStageToggleRef and nextStageToggleRef.Get())
            or (retryStageToggleRef and retryStageToggleRef.Get())
    end
    if not anyStageAuto() then
        return
    end
    task.spawn(function()
        local sawTimer = false
        while g == stageGen do
            if not anyStageAuto() then
                break
            end
            local timer = ReplicatedStorage:GetAttribute("RoundEndTimer")
            if timer == nil then
                sawTimer = false
            elseif not sawTimer then
                sawTimer = true
                task.spawn(function()
                    task.wait(1.15)
                    if g ~= stageGen or not anyStageAuto() then
                        return
                    end
                    if ReplicatedStorage:GetAttribute("RoundEndTimer") == nil then
                        return
                    end
                    fireRoundEndVote(
                        nextStageToggleRef and nextStageToggleRef.Get(),
                        retryStageToggleRef and retryStageToggleRef.Get()
                    )
                end)
            end
            task.wait(0.25)
        end
    end)
end

T:Section("Session")
T:Label("Re-runs after game teleports (new server / lobby). Not after full disconnect — use executor auto-exec.")

local reexecQueued = false
queueToggleRef = T:Toggle(
    "Queue re-execute on teleport",
    "Saves to " .. CONFIG_FILE .. " · loads script from GitHub after TeleportService",
    saved.queueOnTeleport,
    function(on)
        if not on then
            if getgenv then
                getgenv().BonusChestNoQueue = true
            end
            Win:Status("Teleport queue OFF (saved)")
            Win:Notify("Re-exec", "Saved. No un-queue API for this session — re-paste to clear queue.", 4, "warning")
            persistAll()
            return
        end
        if getgenv then
            getgenv().BonusChestNoQueue = nil
        end
        local ok, why = tryQueueOnTeleport()
        reexecQueued = ok
        if ok then
            Win:Status("Bonus chests · will re-run on teleport")
            Win:Notify("Re-exec", "Queued for next server / teleport.", 3, "success")
        elseif why == "skipped" then
            Win:Notify("Re-exec", "BonusChestNoQueue is set — clear getgenv().BonusChestNoQueue", 4, "warning")
        else
            Win:Notify("Re-exec", "queue_on_teleport missing — enable in executor or use auto-exec.", 5, "warning")
        end
        persistAll()
    end
)

-- Queue once on load when saved preference allows
if saved.queueOnTeleport and not (getgenv and getgenv().BonusChestNoQueue == true) then
    local ok = tryQueueOnTeleport()
    reexecQueued = ok
    task.defer(function()
        if ok then
            Win:Notify("Re-exec", "Auto: script runs again after teleport / server change.", 4, "success")
        else
            Win:Notify("Re-exec", "Could not queue (see Session tab).", 4, "warning")
        end
    end)
end

-- Restore toggles from saved config (Toggle does not run cb on first paint)
task.defer(function()
    if saved.autoCollect and autoToggleRef then
        autoToggleRef.Set(true)
    end
    if saved.autoRevive and reviveToggleRef then
        reviveToggleRef.Set(true)
    end
    if saved.autoPlayNextMap and nextStageToggleRef then
        nextStageToggleRef.Set(true)
    end
    if saved.autoRetryStage and retryStageToggleRef then
        retryStageToggleRef.Set(true)
    end
    if saved.autoReadyUp and readyToggleRef then
        readyToggleRef.Set(true)
    end
end)

local _wf = writefile and " · settings saved" or " · read-only (no writefile)"
Win:Status(
    (reexecQueued and "Bonus chests · teleport queue OK" or "Bonus chests · NexusLib")
        .. _wf
)
