--- Quest ids inferred from replicated Profile / Players_Data (many games use QuestEvent:FireServer("Claim", id) only).
local function collectQuestIdsForCategory(category)
    local ids = {}
    local seen = {}
    local function add(s)
        if type(s) == "number" then
            if s ~= math.floor(s) then
                return
            end
            s = tostring(s)
        end
        if type(s) ~= "string" or #s < 1 or #s > 96 then
            return
        end
        if not s:match("^[%w_]+$") then
            return
        end
        if seen[s] then
            return
        end
        seen[s] = true
        ids[#ids + 1] = s
    end
    for _, root in ipairs(profileOrDataRootsForQuests()) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("StringValue") then
                local nlow = string.lower(d.Name)
                local v = d.Value
                if type(v) == "string" and #v > 0 then
                    local nameHint = string.find(nlow, "quest", 1, true)
                        or string.find(nlow, "daily", 1, true)
                        or string.find(nlow, "achiev", 1, true)
                        or string.find(nlow, "task", 1, true)
                        or string.find(nlow, "mission", 1, true)
                    if nameHint then
                        if category == "daily" then
                            if string.find(nlow, "daily", 1, true) or ancestorNameLowerHas(d, root, "daily") then
                                add(v)
                            elseif
                                string.find(nlow, "quest", 1, true)
                                and not ancestorNameLowerHas(d, root, "achiev")
                            then
                                add(v)
                            end
                        else
                            if string.find(nlow, "achiev", 1, true) or ancestorNameLowerHas(d, root, "achiev") then
                                add(v)
                            end
                        end
                    end
                end
                if category == "daily" and ancestorNameLowerHas(d, root, "daily") then
                    local id = d.Name
                    if string.lower(id) ~= "template" and id:match("^[%w_]+$") and #id >= 2 then
                        add(id)
                    end
                end
                if category == "achievement" and ancestorNameLowerHas(d, root, "achiev") then
                    local id = d.Name
                    if string.lower(id) ~= "template" and id:match("^[%w_]+$") and #id >= 2 then
                        add(id)
                    end
                end
            elseif d:IsA("Folder") then
                local par = d.Parent
                if par and par ~= root then
                    local plow = string.lower(par.Name)
                    local id = d.Name
                    if string.lower(id) ~= "template" and id:match("^[%w_]+$") and #id >= 2 then
                        if category == "daily" and string.find(plow, "daily", 1, true) then
                            add(id)
                        elseif category == "achievement" and string.find(plow, "achiev", 1, true) then
                            add(id)
                        end
                    end
                end
            elseif category == "daily" and ancestorNameLowerHas(d, root, "daily") then
                add(d.Name)
            elseif category == "achievement" and ancestorNameLowerHas(d, root, "achiev") then
                add(d.Name)
            end
        end
    end
    if getgenv then
        local g = getgenv()
        if category == "daily" and type(g.BonusChestDailyQuestIds) == "table" then
            for _, x in ipairs(g.BonusChestDailyQuestIds) do
                if type(x) == "string" then
                    add(x)
                elseif type(x) == "number" and x == math.floor(x) and x >= 0 then
                    add(tostring(x))
                end
            end
        elseif category == "achievement" and type(g.BonusChestAchievementQuestIds) == "table" then
            for _, x in ipairs(g.BonusChestAchievementQuestIds) do
                if type(x) == "string" then
                    add(x)
                elseif type(x) == "number" and x == math.floor(x) and x >= 0 then
                    add(tostring(x))
                end
            end
        end
    end
    return ids
end

local function collectQuestIdsFromModule(questsModule, category)
    if type(questsModule) ~= "table" or type(questsModule.GetQuestList) ~= "function" then
        return {}
    end
    local ids, seen = {}, {}
    local ok, list = pcall(function()
        return questsModule:GetQuestList()
    end)
    if not ok or type(list) ~= "table" then
        return ids
    end
    local function addAnyId(raw)
        local id = raw
        if type(id) == "number" and id == math.floor(id) then
            id = tostring(id)
        end
        if type(id) ~= "string" or #id < 1 then
            return
        end
        if seen[id] then
            return
        end
        seen[id] = true
        ids[#ids + 1] = id
    end
    for k, v in pairs(list) do
        local cat = nil
        if type(v) == "table" then
            cat = tostring(v.Category or v.Type or v.QuestType or "")
        end
        local c = string.lower(cat or "")
        if category == "daily" then
            if c == "daily" then
                addAnyId(type(v) == "table" and (v.Id or v.ID or v.Name or v.Key) or nil)
                addAnyId(k)
            end
        elseif category == "achievement" then
            if c == "achievement" or c == "achievements" then
                addAnyId(type(v) == "table" and (v.Id or v.ID or v.Name or v.Key) or nil)
                addAnyId(k)
            end
        end
    end
    return ids
end

local function tryFireQuestEventForCategory(category, perIdsCached)
    local ev = findQuestEventRemote()
    if not ev then
        return false
    end
    if category == "achievement" then
        pcall(function()
            ev:FireServer("ClaimAllAchievements")
        end)
        pcall(function()
            ev:FireServer("ClaimAllAchievement")
        end)
        pcall(function()
            ev:FireServer("Claim", "Achievement")
        end)
        pcall(function()
            ev:FireServer("Claim", "Achievements")
        end)
        pcall(function()
            ev:FireServer("ClaimAll")
        end)
    else
        pcall(function()
            ev:FireServer("ClaimAllDaily")
        end)
        pcall(function()
            ev:FireServer("ClaimAllDailies")
        end)
        pcall(function()
            ev:FireServer("Claim", "Daily")
        end)
        pcall(function()
            ev:FireServer("ClaimDaily")
        end)
        pcall(function()
            ev:FireServer("ClaimAll")
        end)
    end
    local perIds = perIdsCached or collectQuestIdsForCategory(category)
    local cap = 48
    for i = 1, math.min(#perIds, cap) do
        local qid = perIds[i]
        pcall(function()
            ev:FireServer("Claim", qid)
        end)
        pcall(function()
            ev:FireServer("ClaimQuest", qid)
        end)
        pcall(function()
            ev:FireServer("ClaimDaily", qid)
        end)
    end
    return true
end

--- Returns true if a quest module existed or QuestEvent / QuestFunction was invoked.
local function tryClaimQuestCategoryOnce(category)
    local used = false
    local perIds = collectQuestIdsForCategory(category)
    local idsSeen = {}
    for _, q in ipairs(perIds) do
        idsSeen[q] = true
    end
    for _, modName in ipairs({ "Quests", "Achievements", "Quest" }) do
        local m = requireSystemsChildModule(modName)
        if m then
            used = true
            for _, mid in ipairs(collectQuestIdsFromModule(m, category)) do
                if not idsSeen[mid] then
                    idsSeen[mid] = true
                    perIds[#perIds + 1] = mid
                end
            end
            tryClaimQuestCategoryViaModule(m, category)
            tryEnumerateQuestModuleClaims(m, category)
            if type(m.ClaimQuest) == "function" then
                local capIds = math.min(#perIds, 72)
                for i = 1, capIds do
                    local qid = perIds[i]
                    local qn = tonumber(qid)
                    pcall(function()
                        m:ClaimQuest(LP, qid)
                    end)
                    if qn and qn == math.floor(qn) then
                        pcall(function()
                            m:ClaimQuest(LP, qn)
                        end)
                    end
                end
            end
        end
    end
    local cap = 48
    for _, systems in ipairs(getSystemsFolderCandidates()) do
        local rf = systems:FindFirstChild("QuestFunction") or systems:FindFirstChild("QuestInvoke")
        if rf and rf:IsA("RemoteFunction") then
            used = true
            if category == "achievement" then
                pcall(function()
                    rf:InvokeServer("ClaimAllAchievements")
                end)
                pcall(function()
                    rf:InvokeServer("ClaimAllAchievement")
                end)
                pcall(function()
                    rf:InvokeServer("ClaimAll", "Achievement")
                end)
            else
                pcall(function()
                    rf:InvokeServer("ClaimAllDaily")
                end)
                pcall(function()
                    rf:InvokeServer("ClaimAllDailies")
                end)
                pcall(function()
                    rf:InvokeServer("ClaimAll", "Daily")
                end)
            end
            for i = 1, math.min(#perIds, cap) do
                local qid = perIds[i]
                local qn = tonumber(qid)
                pcall(function()
                    rf:InvokeServer("Claim", qid)
                end)
                pcall(function()
                    rf:InvokeServer("ClaimQuest", qid)
                end)
                if qn and qn == math.floor(qn) then
                    pcall(function()
                        rf:InvokeServer("Claim", qn)
                    end)
                    pcall(function()
                        rf:InvokeServer(qn)
                    end)
                end
            end
        end
    end
    do
        local cq = findQuestsClaimQuestRemoteFunction()
        if cq then
            used = true
            pcall(function()
                cq:InvokeServer()
            end)
            if category == "achievement" then
                pcall(function()
                    cq:InvokeServer("ClaimAllAchievements")
                end)
            else
                pcall(function()
                    cq:InvokeServer("ClaimAllDaily")
                end)
            end
            for i = 1, math.min(#perIds, cap) do
                local qid = perIds[i]
                local n = tonumber(qid)
                pcall(function()
                    if n ~= nil then
                        cq:InvokeServer(n)
                    end
                end)
                pcall(function()
                    cq:InvokeServer(qid)
                end)
            end
            if #perIds == 0 and category == "daily" and getgenv then
                local mx = getgenv().BonusChestClaimQuestNumericScanMax
                if type(mx) == "number" then
                    mx = math.clamp(math.floor(mx), 1, 64)
                    for j = 1, mx do
                        pcall(function()
                            cq:InvokeServer(j)
                        end)
                    end
                end
            end
        end
    end
    if tryFireQuestEventForCategory(category, perIds) then
        used = true
    end
    return used
end

