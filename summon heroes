    if equipped then
        local e = equipped:FindFirstChild(unitName)
        if e then
            return e
        end
    end
    if invUnits then
        local i = invUnits:FindFirstChild(unitName)
        if i then
            return i
        end
    end
    return nil
end

--- One fusion if ValidateFusion passes; main first from equipped (by level), then inventory. Returns fused, reason.
local function tryAutoFuseOnce(opts)
    opts = opts or {}
    local minS = math.clamp(tonumber(opts.minStars) or 3, 3, 9)
    local maxS = math.clamp(tonumber(opts.maxStars) or 9, 3, 9)
    if maxS < minS then
        maxS = minS
    end
    local maxFodderLv = tonumber(opts.maxFodderLevel) or 0

    local profile = getPlayerProfileFolder()
    if not profile then
        return false, "no_profile"
    end
    local invRoot = profile:FindFirstChild("Inventory")
    local invUnits = invRoot and invRoot:FindFirstChild("Units")
    local equipped = profile:FindFirstChild("Equipped")
    if not invUnits or not equipped then
        return false, "no_inventory"
    end

    local fusion = getUnitFusionModule()
    if not fusion or type(fusion.ValidateFusion) ~= "function" or type(fusion.PurchaseFuse) ~= "function" then
        return false, "no_fusion"
    end

    local mainId = fuseTrim(opts.fuseMainUnitId or "")
    local sacStr = fuseTrim(opts.fuseSacrificeIds or "")
    if #mainId > 0 or #sacStr > 0 then
        if #mainId == 0 or #sacStr == 0 then
            return false, "bad_manual"
        end
        local sacIds = fuseParseCommaIds(sacStr)
        if #sacIds ~= 3 then
            return false, "bad_manual"
        end
        local main = findFuseMainUnitFolder(equipped, invUnits, mainId)
        if not main then
            return false, "no_main"
        end
        local sac = {}
        for i = 1, 3 do
            local u = invUnits:FindFirstChild(sacIds[i])
            if not u then
                return false, "no_sac"
            end
            sac[i] = u
        end
        if sac[1] == sac[2] or sac[1] == sac[3] or sac[2] == sac[3] then
            return false, "dup_sac"
        end
        local stars = unitAttrStars(main)
        if stars < minS or stars > maxS then
            return false, "stars_filter"
        end
        if type(fusion.GetUpgradeInfo) == "function" and not fusion:GetUpgradeInfo(stars) then
            return false, "no_upgrade_tier"
        end
        for i = 1, 3 do
            if sac[i] == main then
                return false, "main_in_sac"
            end
            if unitAttrStars(sac[i]) ~= stars then
                return false, "star_mismatch"
            end
            if unitIsLocked(sac[i]) then
                return false, "sac_locked"
            end
        end
        local ok = fusion:ValidateFusion(LP, main, sac)
        if not ok then
            return false, "validate_fail"
        end
        local ok2 = fusion:PurchaseFuse(LP, main, sac)
        if ok2 == true then
            return true, nil
        end
        return false, "purchase_fail"
    end

    local function tryMain(main)
        if not main or not main.Parent then
            return false
        end
        local stars = unitAttrStars(main)
        if stars < minS or stars > maxS then
            return false
        end
        if type(fusion.GetUpgradeInfo) == "function" and not fusion:GetUpgradeInfo(stars) then
            return false
        end
        local fodder = collectFuseFodder(invUnits, stars, main, maxFodderLv)
        if #fodder < 3 then
            return false
        end
        local sac = { fodder[1], fodder[2], fodder[3] }
        local ok = fusion:ValidateFusion(LP, main, sac)
        if not ok then
            return false
        end
        local ok2 = fusion:PurchaseFuse(LP, main, sac)
        return ok2 == true
    end

    for stars = minS, maxS do
        if type(fusion.GetUpgradeInfo) ~= "function" or fusion:GetUpgradeInfo(stars) then
            local eqList = {}
            for _, ch in ipairs(equipped:GetChildren()) do
                if unitAttrStars(ch) == stars then
                    eqList[#eqList + 1] = ch
                end
            end
            table.sort(eqList, function(a, b)
                return unitAttrLevel(a) > unitAttrLevel(b)
            end)
            for _, main in ipairs(eqList) do
                if tryMain(main) then
                    return true, nil
                end
            end

            local invMains = {}
            for _, ch in ipairs(invUnits:GetChildren()) do
                if unitAttrStars(ch) == stars and not unitIsLocked(ch) then
                    invMains[#invMains + 1] = ch
                end
            end
            table.sort(invMains, function(a, b)
                return unitAttrLevel(a) > unitAttrLevel(b)
            end)
            for _, main in ipairs(invMains) do
                if tryMain(main) then
                    return true, nil
                end
            end
        end
    end

    return false, "no_match"
end

