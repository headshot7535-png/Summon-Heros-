local function statLetterScore(letter, curves)
    if type(letter) ~= "string" or #letter == 0 then
        return 0
    end
    local L = letter:match("^%s*(%S+)%s*$") or letter
    if curves and type(curves.LetterMultiplier) == "function" then
        local ok, v = pcall(function()
            return curves:LetterMultiplier(L)
        end)
        if ok and type(v) == "number" then
            return v
        end
    end
    local k = string.upper(string.sub(L, 1, 1))
    return LETTER_RANK_SCORE[k] or 0
end

local function getUnitStatLetter(unit, key)
    if not unit then
        return nil
    end
    local function isRankString(s)
        if type(s) ~= "string" or #s == 0 then
            return false
        end
        local k = string.upper(string.sub(s, 1, 1))
        return LETTER_RANK_SCORE[k] ~= nil
    end
    local v = unit:GetAttribute(key)
    if isRankString(v) then
        return v
    end
    local alt = unit:GetAttribute(key .. "Letter") or unit:GetAttribute(key .. "Rank")
    if isRankString(alt) then
        return alt
    end
    return nil
end

