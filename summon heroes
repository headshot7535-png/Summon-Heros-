    if saved.autoClaimAchievements and claimAchievementsToggleRef then
        claimAchievementsToggleRef.Set(true)
    end
    if saved.autoClaimDaily and claimDailyToggleRef then
        claimDailyToggleRef.Set(true)
    end
    if (saved.autoClaimAchievements or saved.autoClaimDaily) then
        task.defer(restartQuestAutoClaimLoop)
    end
    if playerTabRefs.walkSlider and type(playerTabRefs.walkSlider.Set) == "function" then
        playerTabRefs.walkSlider.Set(saved.playerWalkSpeed, false)
    end
    if playerTabRefs.infiniteJump and type(playerTabRefs.infiniteJump.Set) == "function" then
        playerTabRefs.infiniteJump.Set(saved.playerInfiniteJump == true)
    end
    if playerTabRefs.antiAfk and type(playerTabRefs.antiAfk.Set) == "function" then
        playerTabRefs.antiAfk.Set(saved.playerAntiAfk == true)
    end
    if playerTabRefs.noclip and type(playerTabRefs.noclip.Set) == "function" then
        playerTabRefs.noclip.Set(saved.playerNoclip == true)
    end
    if playerTabRefs.godMode and type(playerTabRefs.godMode.Set) == "function" then
        playerTabRefs.godMode.Set(saved.playerGodMode == true)
    end
    task.spawn(function()
        task.wait(1.5)
        pcall(refreshProfileUnitDropdowns)
    end)
end)

