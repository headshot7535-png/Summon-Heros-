        local v = u:GetAttribute(k)
        if type(v) == "string" and #v > 0 then
            return v
        end
    end
    for _, ch in ipairs(u:GetChildren()) do
        if ch:IsA("StringValue") and (ch.Name == "UnitName" or ch.Name == "DisplayName") then
            if type(ch.Value) == "string" and #ch.Value > 0 then
                return ch.Value
            end
        end
    end
    return u.Name
end

local function unitNameFilterMatches(inst, filterTrim)
    if not inst or #filterTrim == 0 then
        return true
    end
    local ft = string.lower(filterTrim)
    local function subMatch(s)
        if type(s) ~= "string" then
            return false
        end
        local sl = string.lower(s)
        return sl == ft or string.find(sl, ft, 1, true) ~= nil
    end
    if subMatch(inst.Name) then
        return true
    end
    for _, k in ipairs({ "UnitName", "DisplayName", "HeroName", "CharacterName", "UnitId" }) do
        local v = inst:GetAttribute(k)
        if type(v) == "string" and subMatch(v) then
            return true
        end
    end
    for _, ch in ipairs(inst:GetChildren()) do
        if ch:IsA("StringValue") and (ch.Name == "UnitName" or ch.Name == "DisplayName" or ch.Name == "Name") then
            if subMatch(ch.Value) then
                return true
            end
        end
    end
    return false
end

--- nameFilter: empty = auto; else exact folder Name under Equipped/Units, or substring on display name / Name.
local function resolveStatRerollUnit(nameFilter)
    local profile = getPlayerProfileFolder()
    if not profile then
        return nil
    end
    local equipped = profile:FindFirstChild("Equipped")
    local invRoot = profile:FindFirstChild("Inventory")
    local invUnits = invRoot and invRoot:FindFirstChild("Units")
    local filterTrim = type(nameFilter) == "string" and (nameFilter:match("^%s*(.-)%s*$") or "") or ""
    local wantFilter = #filterTrim > 0

    if wantFilter then
        local direct = equipped and equipped:FindFirstChild(filterTrim)
        if not direct and invUnits then
            direct = invUnits:FindFirstChild(filterTrim)
        end
        if direct then
            return direct
        end
    end

    local function matchName(inst)
        if not wantFilter then
            return true
        end
        return unitNameFilterMatches(inst, filterTrim)
    end

    local best = nil
    local function consider(u)
        if not u or not u.Parent then
            return
        end
        if not matchName(u) then
            return
        end
        if not best or unitAttrLevel(u) > unitAttrLevel(best) then
            best = u
        end
    end

    if equipped then
        for _, u in ipairs(equipped:GetChildren()) do
            consider(u)
        end
    end
    if invUnits then
        for _, u in ipairs(invUnits:GetChildren()) do
            consider(u)
        end
    end
    if best then
        return best
    end
    if wantFilter then
        return nil
    end

    if equipped then
        local eq = {}
        for _, u in ipairs(equipped:GetChildren()) do
            eq[#eq + 1] = u
        end
        table.sort(eq, function(a, b)
            return unitAttrLevel(a) > unitAttrLevel(b)
        end)
        if eq[1] then
            return eq[1]
        end
    end
    if invUnits then
        local inv = {}
        for _, u in ipairs(invUnits:GetChildren()) do
            if not unitIsLocked(u) then
                inv[#inv + 1] = u
            end
        end
        table.sort(inv, function(a, b)
            return unitAttrLevel(a) > unitAttrLevel(b)
        end)
        if inv[1] then
            return inv[1]
        end
    end
    return nil
end

