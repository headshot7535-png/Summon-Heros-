--- Activate() alone often does not run local scripts; executors expose getconnections to fire MouseButton1Click.
local function fireGuiButtonClick(btn)
    if not btn or not btn:IsA("GuiButton") then
        return
    end
    pcall(function()
        btn:Activate()
    end)
    pcall(function()
        local gc = getconnections
        if type(gc) ~= "function" then
            return
        end
        local conns = gc(btn.MouseButton1Click)
        if type(conns) ~= "table" then
            return
        end
        for _, conn in ipairs(conns) do
            local fn = conn.Function
            if type(fn) == "function" then
                pcall(fn)
            end
        end
    end)
end

