--- Deep-search PlayerGui + RS for a named RemoteEvent/Function.
--- Summon Heroes stores remotes as children of the CLIENT LocalScript,
--- NOT in RS.Systems.Queue. We search broadly to handle both layouts.
local _remoteCache = {}
local _remoteMissCache = {}
local REMOTE_MISS_CACHE_SEC = 1.5
local function findRemoteAnywhere(name)
    local now = os.clock()
    if _remoteCache[name] and _remoteCache[name].Parent then
        return _remoteCache[name]
    end
    if _remoteMissCache[name] and (now - _remoteMissCache[name]) < REMOTE_MISS_CACHE_SEC then
        return nil
    end
    -- 1. RS.Systems.Queue (canonical script path)
    local sys = getSystemsFolder()
    if sys then
        local qf = sys:FindFirstChild("Queue")
        local r = qf and qf:FindFirstChild(name)
        if r and (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") or r:IsA("RemoteFunction")) then
            _remoteCache[name] = r
            _remoteMissCache[name] = nil
            return r
        end
        -- Also check directly in Systems
        r = sys:FindFirstChild(name, true)
        if r and (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") or r:IsA("RemoteFunction")) then
            _remoteCache[name] = r
            _remoteMissCache[name] = nil
            return r
        end
    end
    -- 2. CLIENT LocalScript children (Players.X.PlayerGui.CLIENT.LocalScript.X)
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        local client = pg:FindFirstChild("CLIENT")
        if client then
            local ls = client:FindFirstChildWhichIsA("LocalScript")
            if ls then
                local r = ls:FindFirstChild(name)
                if r and (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") or r:IsA("RemoteFunction")) then
                    _remoteCache[name] = r
                    _remoteMissCache[name] = nil
                    return r
                end
                -- Also check Remotes subfolder if present
                local remFolder = ls:FindFirstChild("Remotes")
                if remFolder then
                    r = remFolder:FindFirstChild(name)
                    if r and (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") or r:IsA("RemoteFunction")) then
                        _remoteCache[name] = r
                        _remoteMissCache[name] = nil
                        return r
                    end
                end
            end
            -- Deep search all LocalScripts under CLIENT
            for _, ls2 in ipairs(client:GetDescendants()) do
                if ls2:IsA("LocalScript") or ls2:IsA("Script") then
                    local r = ls2:FindFirstChild(name)
                    if r and (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") or r:IsA("RemoteFunction")) then
                        _remoteCache[name] = r
                        _remoteMissCache[name] = nil
                        return r
                    end
                end
            end
        end
        -- Broader PlayerGui descendant search
        for _, d in ipairs(pg:GetDescendants()) do
            if d.Name == name and (d:IsA("RemoteEvent") or d:IsA("UnreliableRemoteEvent") or d:IsA("RemoteFunction")) then
                _remoteCache[name] = d
                _remoteMissCache[name] = nil
                return d
            end
        end
    end
    -- 3. RS deep search
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d.Name == name and (d:IsA("RemoteEvent") or d:IsA("UnreliableRemoteEvent") or d:IsA("RemoteFunction")) then
            _remoteCache[name] = d
            _remoteMissCache[name] = nil
            return d
        end
    end
    _remoteMissCache[name] = now
    return nil
end

