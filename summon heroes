-- ==================== AUTO BONUS CHESTS ====================
-- G.loop acts as generation id (same idea as chestLoopId): incrementing kills the previous loop.
local function runAutoBonusChestLoop(gen)
    spawnTracked(function()
        Win:Status("Auto Bonus Chests → ENABLED")
        while gen == G.loop and bonusChestUiAlive(UI_RUN_GEN) do
            if isBonusChestLobbyForAutoCollect() then
                local anyCollected = false
                local parts = CollectionService:GetTagged("BonusChestPart")
                for _, chestInst in ipairs(parts) do
                    if gen ~= G.loop or not bonusChestUiAlive(UI_RUN_GEN) then
                        break
                    end
                    if chestInst and chestInst.Parent and chestInst:IsDescendantOf(workspace) then
                        local prompt = chestInst:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and prompt.Enabled then
                            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local baseCf = getBonusChestWorldCFrame(chestInst)
                                if baseCf then
                                    pcall(function()
                                        hrp.AssemblyLinearVelocity = Vector3.zero
                                        hrp.CFrame = baseCf * CFrame.new(0, 5, 0)
                                    end)
                                    task.wait(0.35)
                                    fireProximityPromptExec(prompt)
                                    anyCollected = true
                                    Win:Status("✓ Collected Bonus Chest")
                                    setHint("Last: bonus chest")
                                    task.wait(0.8)
                                end
                            end
                        end
                    end
                end
                if gen ~= G.loop or not bonusChestUiAlive(UI_RUN_GEN) then
                    break
                end
                task.wait(anyCollected and 0.8 or 1.5)
            else
                task.wait(2)
            end
        end
        Win:Status("Auto Bonus Chests → DISABLED")
    end)
end

