--- ReplicatedStorage.Systems or ReplicatedStorage.Remotes.Systems (game-dependent).
local function getSystemsFolder()
    local rs = ReplicatedStorage
    local s = rs:FindFirstChild("Systems")
    if s then
        return s
    end
    local rem = rs:FindFirstChild("Remotes")
    if rem then
        return rem:FindFirstChild("Systems")
    end
    return nil
end

--- True if this GuiObject and ancestors are visible and owning ScreenGui (if any) is enabled.
local function guiObjectShownOnScreen(inst)
    if not inst or not inst:IsA("GuiObject") or not inst.Visible then
        return false
    end
    local p = inst
    while p do
        if p:IsA("GuiObject") and not p.Visible then
            return false
        end
        if p:IsA("ScreenGui") and not p.Enabled then
            return false
        end
        p = p.Parent
    end
    return true
end

--- First FindFirstChild can hit a hidden template; prefer any *shown* instance with this name.
local function playerGuiDescendantShown(name)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        return false
    end
    for _, d in ipairs(pg:GetDescendants()) do
        if d.Name == name and d:IsA("GuiObject") and guiObjectShownOnScreen(d) then
            return true
        end
    end
    return false
end

local ROUND_END_NEXT_NAMES = { "NextStageButton", "NextStage", "NextMapButton", "NextButton" }
local ROUND_END_RETRY_NAMES = { "RestartButton", "RetryStage", "RetryButton", "Retry" }

local function roundEndAnyNameVisible(names)
    for _, n in ipairs(names) do
        if playerGuiDescendantShown(n) then
            return true
        end
    end
    return false
end

local function labelTextIsNextStage(txt)
    local s = string.lower(tostring(txt or ""))
    if string.find(s, "lobby", 1, true) then
        return false
    end
    local hasNext = string.find(s, "next", 1, true) ~= nil
    local hasStageOrMap = string.find(s, "stage", 1, true) or string.find(s, "map", 1, true)
    return hasNext and hasStageOrMap
end

local function labelTextIsRetryStage(txt)
    local s = string.lower(tostring(txt or ""))
    if string.find(s, "lobby", 1, true) then
        return false
    end
    return string.find(s, "retry", 1, true) ~= nil
end

--- Finds a visible GuiButton whose label text matches live UI ("Next Stage", "Retry Stage", etc.).
local function findShownGuiButtonForRoundEnd(which)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        return nil
    end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local txt = d.Text
            local ok = (which == "next" and labelTextIsNextStage(txt))
                or (which == "retry" and labelTextIsRetryStage(txt))
            if ok then
                local node = d
                while node do
                    if node:IsA("GuiButton") and guiObjectShownOnScreen(node) then
                        return node
                    end
                    node = node.Parent
                end
            end
        end
    end
    return nil
end

local function roundEndNextUiVisible()
    if roundEndAnyNameVisible(ROUND_END_NEXT_NAMES) then
        return true
    end
    return findShownGuiButtonForRoundEnd("next") ~= nil
end

local function roundEndRetryUiVisible()
    if roundEndAnyNameVisible(ROUND_END_RETRY_NAMES) then
        return true
    end
    return findShownGuiButtonForRoundEnd("retry") ~= nil
end

local function getTryReviveRemote()
    local systems = getSystemsFolder()
    local waves = systems and systems:FindFirstChild("Waves")
    return waves and waves:FindFirstChild("TryReviveUnit")
end

local function getEquippedFolder()
    local pg = LP:FindFirstChild("PlayerGui")
    local profile = pg and pg:FindFirstChild("Profile")
    return profile and profile:FindFirstChild("Equipped")
end

local function unitModelForEquippedSlot(slot)
    local units = workspace:FindFirstChild("Units")
    if not units then
        return nil
    end
    for _, m in ipairs(units:GetChildren()) do
        if m:IsA("Model") and m:GetAttribute("OwnerName") == LP.Name then
            local ref = m:FindFirstChild("DataRef")
            if ref and ref:IsA("ObjectValue") and ref.Value == slot then
                return m
            end
        end
    end
    return nil
end

--- Matches server revive rule: only when no live spawned unit for that Equipped folder (DataRef + Humanoid.Health).
local function isEquippedSlotDeadForRevive(slot)
    if not slot or not slot.Parent then
        return false
    end
    local model = unitModelForEquippedSlot(slot)
    if not model then
        if workspace:GetAttribute("RoundStarted") ~= true then
            return false
        end
        return true
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then
        return true
    end
    return hum.Health <= 0
end

--- Fires TryReviveUnit only for equipped slots whose unit is dead or not spawned (during an active round).
local function fireReviveAllSlots()
    local ev = getTryReviveRemote()
    if not ev or not ev:IsA("RemoteEvent") then
        return false
    end
    local eq = getEquippedFolder()
    if not eq then
        return false
    end
    local any = false
    for _, slot in ipairs(eq:GetChildren()) do
        if isEquippedSlotDeadForRevive(slot) then
            any = true
            pcall(function()
                ev:FireServer(slot)
            end)
        end
    end
    return any
end

local function collectPromoCodeStrings()
    local out, seen = {}, {}
    local function add(s)
        if type(s) ~= "string" then
            return
        end
        s = (s:match("^%s*(.-)%s*$") or "")
        if #s == 0 then
            return
        end
        local key = string.lower(s)
        if seen[key] then
            return
        end
        seen[key] = true
        out[#out + 1] = s
    end
    if getgenv and type(getgenv().BonusChestPromoCodes) == "table" then
        local g = getgenv().BonusChestPromoCodes
        for _, c in ipairs(g) do
            add(c)
        end
        if #out == 0 then
            for _, c in pairs(g) do
                add(c)
            end
        end
    end
    for _, c in ipairs(PROMO_CODES_EDIT) do
        add(c)
    end
    return out
end

local function getClaimCodeRemote()
    local systems = getSystemsFolder()
    local promo = systems and systems:FindFirstChild("PromoCodes")
    local r = promo and promo:FindFirstChild("ClaimCode")
    if r and r:IsA("RemoteEvent") then
        return r
    end
    return nil
end

local function redeemPromoCodesOnce()
    local ev = getClaimCodeRemote()
    if not ev then
        return false, "no_remote"
    end
    local codes = collectPromoCodeStrings()
    if #codes == 0 then
        return false, "no_codes"
    end
    for _, code in ipairs(codes) do
        pcall(function()
            ev:FireServer(code)
        end)
        task.wait(0.4)
    end
    return true, nil
end

local function isShopBuyRemote(ev)
    return ev
        and (
            ev:IsA("RemoteEvent")
            or ev:IsA("UnreliableRemoteEvent")
            or ev:IsA("RemoteFunction")
        )
end

local function fireShopBuy(buyEv, shopKey, slotIndex)
    if buyEv:IsA("RemoteFunction") then
        pcall(function()
            buyEv:InvokeServer(shopKey, slotIndex)
        end)
    else
        pcall(function()
            buyEv:FireServer(shopKey, slotIndex)
        end)
    end
end

--- RotatingShops (Item Shop / PvP Shop): BuyItem remote + module for GetCurrentShopItems / HasStock.
local function resolveRotatingShopsBuy()
    local systems = getSystemsFolder()
    if not systems then
        return nil, nil
    end
    local node = systems:FindFirstChild("RotatingShops")
    if not node then
        return nil, nil
    end
    local buyEv
    local modScript
    if node:IsA("ModuleScript") then
        modScript = node
        buyEv = node.Parent and node.Parent:FindFirstChild("BuyItem")
    elseif node:IsA("Folder") then
        modScript = node:FindFirstChild("RotatingShops") or node:FindFirstChildWhichIsA("ModuleScript")
        buyEv = node:FindFirstChild("BuyItem")
    end
    if not (buyEv and isShopBuyRemote(buyEv) and modScript and modScript:IsA("ModuleScript")) then
        return nil, nil
    end
    local ok, mod = pcall(require, modScript)
    if not ok or type(mod) ~= "table" then
        return nil, buyEv
    end
    return mod, buyEv
end

