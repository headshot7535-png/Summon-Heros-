local function buildRotatingShopItemsForUi(shopKey)
    local rotMod = resolveRotatingShopsBuy()
    if type(rotMod) ~= "table" then
        return nil
    end
    local names, seen = {}, { ["*"] = true }
    for _, key in ipairs(rotatingShopCandidateKeys(shopKey)) do
        local items = rotatingShopGetItems(rotMod, key)
        if type(items) == "table" then
            for i = 1, 32 do
                local entry = items[i] or items[tostring(i)]
                if type(entry) == "table" then
                    local nm = entry.ItemName or entry.Name or entry.Id
                    if type(nm) == "string" and #nm > 0 and not seen[nm] then
                        seen[nm] = true
                        names[#names + 1] = nm
                    end
                end
            end
            for _, entry in pairs(items) do
                if type(entry) == "table" then
                    local nm = entry.ItemName or entry.Name or entry.Id
                    if type(nm) == "string" and #nm > 0 and not seen[nm] then
                        seen[nm] = true
                        names[#names + 1] = nm
                    end
                end
            end
        end
    end
    if #names == 0 then
        return nil
    end
    table.sort(names, function(a, b)
        return string.lower(a) < string.lower(b)
    end)
    local out = { "*" }
    for _, nm in ipairs(names) do
        out[#out + 1] = nm
    end
    return out
end

