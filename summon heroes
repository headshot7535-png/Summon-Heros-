--- Pick trait reroll API:
--- - two_step: buy pending + confirm (TraitRerollAction / RerollAction)
--- - one_step: reroll is already applied (RerollTrait / BuyTraitReroll-only layouts)
local function resolveTraitRerollFunctions(upgrades)
    if not upgrades then
        return nil, nil, nil
    end
    local pairsToTry = {
        { upgrades.BuyTraitReroll, upgrades.TraitRerollAction },
        { upgrades.PurchaseTraitReroll, upgrades.TraitRerollAction },
        { upgrades.BuyTraitReroll, upgrades.RerollTraitAction },
        { upgrades.PurchaseTraitReroll, upgrades.RerollTraitAction },
        { upgrades.BuyTraitReroll, upgrades.RerollAction },
        { upgrades.PurchaseTraitReroll, upgrades.RerollAction },
    }
    for _, pr in ipairs(pairsToTry) do
        local buyFn, actFn = pr[1], pr[2]
        if type(buyFn) == "function" and type(actFn) == "function" then
            return buyFn, actFn, "two_step"
        end
    end
    -- Some games expose a direct one-call trait reroll (already applies new trait).
    if type(upgrades.RerollTrait) == "function" then
        return upgrades.RerollTrait, nil, "one_step"
    end
    if type(upgrades.BuyTraitReroll) == "function" then
        return upgrades.BuyTraitReroll, nil, "one_step"
    end
    if type(upgrades.PurchaseTraitReroll) == "function" then
        return upgrades.PurchaseTraitReroll, nil, "one_step"
    end
    return nil, nil, nil
end

--- Returns ok, reason: goal_met, discarded, used_new, applied_no_goal, buy_failed, no_module, no_unit, no_match, no_goals, already_goal, bad_roll
local function tryTraitRerollOnce(opts)
    opts = opts or {}
    local upgrades = getUnitUpgradesModule()
    local buyFn, actFn, traitApiMode = resolveTraitRerollFunctions(upgrades)
    if not buyFn then
        return false, "no_module"
    end

    local nameFilter = opts.unitNameFilter
    if getgenv and type(getgenv().BonusChestTraitRerollUnit) == "string" and #getgenv().BonusChestTraitRerollUnit > 0 then
        nameFilter = getgenv().BonusChestTraitRerollUnit
    end

    local unit = resolveStatRerollUnit(nameFilter)
    if not unit then
        local trim = type(nameFilter) == "string" and (nameFilter:match("^%s*(.-)%s*$") or "") or ""
        if #trim > 0 then
            return false, "no_match"
        end
        return false, "no_unit"
    end

    if opts.skipAnim then
        trySetSkipTraitRerollAnim(true)
    end

    local mode = opts.mode or "until_goal"
    if getgenv and (getgenv().BonusChestTraitRerollMode == "until_goal" or getgenv().BonusChestTraitRerollMode == "always_apply") then
        mode = getgenv().BonusChestTraitRerollMode
    end

    local goalCsv = opts.goalCsv or ""
    if getgenv and type(getgenv().BonusChestTraitRerollGoals) == "string" then
        goalCsv = getgenv().BonusChestTraitRerollGoals
    end
    local goals = parseCommaGoals(buildTraitGoalCsvFromInputs(goalCsv, opts.goalList))

    if mode == "until_goal" and #goals == 0 then
        return false, "no_goals"
    end

    if mode == "until_goal" then
        local curTrait = getUnitTraitDisplayName(unit)
        if #curTrait > 0 and traitNameMatchesGoals(curTrait, goals) then
            return false, "already_goal"
        end
    end

    local prevTrait = getUnitTraitDisplayName(unit)
    local okBuy, ret = pcall(function()
        return buyFn(upgrades, LP, unit)
    end)
    if not okBuy then
        return false, "buy_failed"
    end

    local newTrait = parseTraitFromRerollResult(ret)
    if #newTrait == 0 then
        local afterTrait = getUnitTraitDisplayName(unit)
        if #afterTrait > 0 and afterTrait ~= prevTrait then
            newTrait = afterTrait
        end
    end

    if traitApiMode == "one_step" then
        if mode == "until_goal" then
            if #newTrait == 0 then
                return false, "bad_roll"
            end
            if traitNameMatchesGoals(newTrait, goals) then
                return true, "goal_met"
            end
            return true, "applied_no_goal"
        end
        return true, "used_new"
    end

    local useNew = true
    if mode == "until_goal" then
        if #newTrait == 0 then
            pcall(function()
                actFn(upgrades, LP, "KeepCurrent")
            end)
            return false, "bad_roll"
        end
        useNew = traitNameMatchesGoals(newTrait, goals)
    end

    pcall(function()
        actFn(upgrades, LP, useNew and "UseNew" or "KeepCurrent")
    end)

    if mode == "until_goal" then
        if useNew then
            return true, "goal_met"
        end
        return true, "discarded"
    end
    return true, "used_new"
end

