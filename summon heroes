-- Raw script (Summon-Heros); re-fetched after teleport / server hop.
local SCRIPT_SOURCE_URL = (getgenv and getgenv().BonusChestScriptUrl)
    or "https://raw.githubusercontent.com/headshot7535-png/Summon-Heros-/main/summon%20heroes"

local QUEUE_DEDUP_SEC = 1.25
local function tryQueueOnTeleport(reason, forceQueue)
    if getgenv and getgenv().BonusChestNoQueue == true then
        return false, "skipped"
    end
    local code = string.format("loadstring(game:HttpGet(%q, true))()", SCRIPT_SOURCE_URL)
    local st = ((getgenv and getgenv()) or _G)
    local now = os.clock()
    if forceQueue ~= true then
        local lastAt = tonumber(st._BonusChestLastQueueAt) or 0
        local lastCode = st._BonusChestLastQueueCode
        if type(lastCode) == "string" and lastCode == code and (now - lastAt) < QUEUE_DEDUP_SEC then
            return true, "dedup"
        end
    end
    local candidates = {
        typeof(queue_on_teleport) == "function" and queue_on_teleport,
        typeof(syn) == "table" and syn.queue_on_teleport,
        typeof(fluxus) == "table" and fluxus.queue_on_teleport,
        typeof(Krnl) == "table" and Krnl.queue_on_teleport,
        getgenv and typeof(getgenv().queue_on_teleport) == "function" and getgenv().queue_on_teleport,
    }
    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            local ok = pcall(fn, code)
            if ok then
                st._BonusChestLastQueueAt = now
                st._BonusChestLastQueueCode = code
                st._BonusChestLastQueueReason = tostring(reason or "generic")
                return true, nil
            end
        end
    end
    return false, "no_api"
end

