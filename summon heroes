function buildTraitKeepOptions()
    local defs = getAllTraitDefs()
    local list = {}
    for name, def in pairs(defs) do
        local rarity = tonumber(def and def.Rarity) or 0
        local function pct(v)
            if type(v) ~= "number" or v == 0 then
                return nil
            end
            local sign = v > 0 and "+" or ""
            return sign .. tostring(math.round(v * 1000) / 10) .. "%"
        end
        local bits = {}
        local hp = pct(def and def.HP)
        local dmg = pct(def and def.DMG)
        local cd = pct(def and def.CD)
        local spd = pct(def and def.SPD)
        if hp then bits[#bits + 1] = "HP " .. hp end
        if dmg then bits[#bits + 1] = "DMG " .. dmg end
        if cd then bits[#bits + 1] = "CD " .. cd end
        if spd then bits[#bits + 1] = "SPD " .. spd end
        local statTxt = (#bits > 0) and (" · " .. table.concat(bits, " ")) or ""
        list[#list + 1] = {
            text = string.format("[R%d] %s%s", rarity, name, statTxt),
            value = name,
            rarity = rarity,
            name = name,
        }
    end
    table.sort(list, function(a, b)
        if a.rarity ~= b.rarity then
            return a.rarity < b.rarity
        end
        return string.lower(a.name) < string.lower(b.name)
    end)
    local opts = {}
    for i, row in ipairs(list) do
        opts[i] = { text = row.text, value = row.value }
    end
    if #opts == 0 then
        local fallback = {
            "Sturdy", "Brutal", "Nimble", "Swift",
            "Berserker", "Godspeed", "Sprinter", "Vanguard",
            "Overclocked", "Titan", "Divine", "Ultimate",
        }
        for i, name in ipairs(fallback) do
            opts[i] = { text = name, value = name }
        end
    end
    return opts
end

