            if type(id) == "string" and #id > 0 then
                ids[#ids + 1] = id
            end
        elseif type(v) == "string" and #v > 0 then
            ids[#ids + 1] = v
        end
    end
    if #ids == 0 then
        return false, 0, "none_ready"
    end
    local claimed = 0
    for i = 1, math.min(#ids, 120) do
        local id = ids[i]
        local didClaim = false
        pcall(function()
            local okClaim = m:ClaimReward(LP, id)
            if okClaim == true then
                didClaim = true
            end
        end)
        if not didClaim then
            pcall(function()
                local okClaim = m.ClaimReward(m, LP, id)
                if okClaim == true then
                    didClaim = true
                end
            end)
        end
        if didClaim then
            claimed = claimed + 1
        end
        task.wait(0.06)
    end
    return true, claimed, nil
end

