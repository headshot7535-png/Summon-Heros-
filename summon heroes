        locked[#locked + 1] = "Health"
    end
    if lockCd then
        locked[#locked + 1] = "Cooldown"
    end
    if lockSpd then
        locked[#locked + 1] = "Speed"
    end
    return locked
end

getStatRerollUnlockedKeys = function(lockedList)
    local skip = {}
    for _, k in ipairs(lockedList) do
        skip[k] = true
    end
    local out = {}
