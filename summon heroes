function findLatestSweepTarget()
    local ok, waveData = pcall(function()
        return require(game.ReplicatedStorage.Systems.Waves.WaveData)
    end)
    if not ok or type(waveData) ~= "table" then
        return nil, nil
    end
    local maps = {}
    for key, data in pairs(waveData) do
        if type(key) == "string"
            and type(data) == "table"
            and not data.Hidden
            and not data.IsRaid
            and not data.IsDungeon
            and type(data.Stages) == "table" then
            maps[#maps + 1] = { key = key, order = tonumber(data.Order) or 0, stages = #data.Stages }
        end
    end
    table.sort(maps, function(a, b)
        if a.order == b.order then
            return tostring(a.key) > tostring(b.key)
        end
        return a.order > b.order
    end)
    for _, m in ipairs(maps) do
        for st = math.max(1, m.stages), 1, -1 do
            if canPlayStoryStageNow(m.key, st) then
                return m.key, st
            end
        end
    end
    return nil, nil
end

