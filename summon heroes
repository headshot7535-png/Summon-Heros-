        return ""
    end
    for _, key in ipairs({ "Trait", "TraitName", "UnitTrait", "TraitId" }) do
        local v = unit:GetAttribute(key)
        if type(v) == "string" and #v > 0 then
            return v
        end
        if type(v) == "number" then
            return tostring(v)
        end
    end
    return ""
end

local function parseTraitFromRerollResult(ret)
    if type(ret) == "string" and #ret > 0 then
        return ret
    end
    if type(ret) == "table" then
        local k = ret.TraitName or ret.Name or ret.Trait or ret.NewTrait or ret.DisplayName
        if type(k) == "string" and #k > 0 then
            return k
        end
        if type(k) == "number" then
            return tostring(k)
        end
        for _, v in pairs(ret) do
            if type(v) == "string" and #v > 2 and not string.match(v, "^%d+$") then
                return v
            end
        end
    end
    return ""
end

local function traitNameMatchesGoals(traitName, goals)
    if type(traitName) ~= "string" or #traitName == 0 then
        return false
    end
    local tn = string.lower(traitName)
    for _, g in ipairs(goals) do
        if type(g) == "string" and #g > 0 then
            local gl = string.lower(g)
            if string.find(tn, gl, 1, true) then
                return true
            end
        end
    end
    return false
end

