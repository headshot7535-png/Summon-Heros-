--- True if this GuiObject and ancestors are visible and owning ScreenGui (if any) is enabled.
local function guiObjectShownOnScreen(inst)
    if not inst or not inst:IsA("GuiObject") or not inst.Visible then
        return false
    end
    local p = inst
    while p do
        if p:IsA("GuiObject") and not p.Visible then
            return false
        end
        if p:IsA("ScreenGui") and not p.Enabled then
            return false
        end
        p = p.Parent
    end
    return true
end

--- First FindFirstChild can hit a hidden template; prefer any *shown* instance with this name.
local _pgShownCache = { name = "", t = 0, v = false }
local PG_SHOWN_CACHE_SEC = 0.22
local function playerGuiDescendantShown(name)
    local now = os.clock()
    if _pgShownCache.name == name and (now - _pgShownCache.t) < PG_SHOWN_CACHE_SEC then
        return _pgShownCache.v
    end
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        _pgShownCache = { name = name, t = now, v = false }
        return false
    end
    local out = false
    for _, d in ipairs(pg:GetDescendants()) do
        if d.Name == name and d:IsA("GuiObject") and guiObjectShownOnScreen(d) then
            out = true
            break
        end
    end
    _pgShownCache = { name = name, t = now, v = out }
    return out
end

local function labelTextIsNextStage(txt)
    local s = string.lower(tostring(txt or ""))
    if string.find(s, "lobby", 1, true) then
        return false
    end
    local hasNext = string.find(s, "next", 1, true) ~= nil
    local hasStageOrMap = string.find(s, "stage", 1, true) or string.find(s, "map", 1, true)
    return hasNext and hasStageOrMap
end

local function labelTextIsRetryStage(txt)
    local s = string.lower(tostring(txt or ""))
    if string.find(s, "lobby", 1, true) then
        return false
    end
    return string.find(s, "retry", 1, true) ~= nil
end

local ROUND_END_NEXT_NAMES = { "NextStageButton", "NextStage", "NextMapButton", "NextButton" }
local ROUND_END_RETRY_NAMES = { "RestartButton", "RetryStage", "RetryButton", "Retry" }
local ROUND_END_NEXT_SET, ROUND_END_RETRY_SET = {}, {}
for _, n in ipairs(ROUND_END_NEXT_NAMES) do
    ROUND_END_NEXT_SET[n] = true
end
for _, n in ipairs(ROUND_END_RETRY_NAMES) do
    ROUND_END_RETRY_SET[n] = true
end
local _roundEndVoteVisibleCache = { t = 0, next = false, retry = false }
local ROUND_END_VOTE_CACHE_SEC = 0.12

--- One PlayerGui scan for both vote buttons (stage vote + fireRoundEndVote call this; avoids 4–8 full scans per tick).
local function getRoundEndVoteButtonsVisible()
    local now = os.clock()
    if (now - _roundEndVoteVisibleCache.t) < ROUND_END_VOTE_CACHE_SEC then
        return _roundEndVoteVisibleCache.next, _roundEndVoteVisibleCache.retry
    end
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        _roundEndVoteVisibleCache = { t = now, next = false, retry = false }
        return false, false
    end
    local nextHit, retryHit = false, false
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("GuiObject") and (ROUND_END_NEXT_SET[d.Name] or ROUND_END_RETRY_SET[d.Name]) and guiObjectShownOnScreen(d) then
            if ROUND_END_NEXT_SET[d.Name] then
                nextHit = true
            end
            if ROUND_END_RETRY_SET[d.Name] then
                retryHit = true
            end
            if nextHit and retryHit then
                _roundEndVoteVisibleCache = { t = now, next = true, retry = true }
                return true, true
            end
        elseif not nextHit or not retryHit then
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local txt = d.Text
                if not nextHit and labelTextIsNextStage(txt) then
                    local node = d
                    while node do
                        if node:IsA("GuiButton") and guiObjectShownOnScreen(node) then
                            nextHit = true
                            break
                        end
                        node = node.Parent
                    end
                elseif not retryHit and labelTextIsRetryStage(txt) then
                    local node = d
                    while node do
                        if node:IsA("GuiButton") and guiObjectShownOnScreen(node) then
                            retryHit = true
                            break
                        end
                        node = node.Parent
                    end
                end
            end
        end
        if nextHit and retryHit then
            break
        end
    end
    _roundEndVoteVisibleCache = { t = now, next = nextHit, retry = retryHit }
    return nextHit, retryHit
end

--- Activate path for Voting:Vote — separate scan only when firing (getRoundEndVoteButtonsVisible already matched text).
local function findShownGuiButtonForRoundEnd(which)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        return nil
    end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local txt = d.Text
            local ok = (which == "next" and labelTextIsNextStage(txt))
                or (which == "retry" and labelTextIsRetryStage(txt))
            if ok then
                local node = d
                while node do
                    if node:IsA("GuiButton") and guiObjectShownOnScreen(node) then
                        return node
                    end
                    node = node.Parent
                end
            end
        end
    end
    return nil
end

local function collectPromoCodeStrings()
    local out, seen = {}, {}
    local function add(s)
        if type(s) ~= "string" then
            return
        end
        s = (s:match("^%s*(.-)%s*$") or "")
        if #s == 0 then
            return
        end
        local key = string.lower(s)
        if seen[key] then
            return
        end
        seen[key] = true
        out[#out + 1] = s
    end
    if getgenv and type(getgenv().BonusChestPromoCodes) == "table" then
        local g = getgenv().BonusChestPromoCodes
        for _, c in ipairs(g) do
            add(c)
        end
        if #out == 0 then
            for _, c in pairs(g) do
                add(c)
            end
        end
    end
    for _, c in ipairs(PROMO_CODES_EDIT) do
        add(c)
    end
    return out
end

