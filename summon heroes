--- Default multi-indices + optional extra comma string for unknown names (preserves saved config).
local function rotatingShopSplitSavedIntoKnownAndExtra(savedCsv)
    local known = rotatingShopKnownValueToIndex()
    local s = type(savedCsv) == "string" and (savedCsv:match("^%s*(.-)%s*$") or "") or ""
    if #s == 0 or s == "*" then
        return { 1 }, ""
    end
    local indices = {}
    local seen = {}
    local extras = {}
    for part in string.gmatch(s, "[^,]+") do
        local k = (part:match("^%s*(.-)%s*$") or "")
        if #k > 0 then
            local idx = known[string.lower(k)]
            if idx then
                if not seen[idx] then
                    seen[idx] = true
                    indices[#indices + 1] = idx
                end
            else
                extras[#extras + 1] = k
            end
        end
    end
    if #indices == 0 and #extras == 0 then
        return { 1 }, ""
    end
    if #indices == 0 then
        return { 1 }, table.concat(extras, ",")
    end
    return indices, table.concat(extras, ",")
end

local function rotatingShopFilterStringFromValues(values)
    if type(values) ~= "table" or #values == 0 then
        return "*"
    end
    local hasStar = false
    local parts = {}
    for _, v in ipairs(values) do
        local sv = tostring(v)
        if sv == "*" then
            hasStar = true
        else
            parts[#parts + 1] = sv
        end
    end
    if hasStar and #parts == 0 then
        return "*"
    end
    if hasStar then
        return "*"
    end
    return table.concat(parts, ",")
end

local function mergeRotatingShopExtra(base, extra)
    local b = type(base) == "string" and (base:match("^%s*(.-)%s*$") or "") or ""
    local e = type(extra) == "string" and (extra:match("^%s*(.-)%s*$") or "") or ""
    if #e == 0 then
        return b
    end
    if #b == 0 or b == "*" then
        return e
    end
    return b .. "," .. e
end

local function readRotatingShopFilterString(multiRef, inputRef)
    local vals
    if multiRef and type(multiRef.Get) == "function" then
        _, vals = multiRef.Get()
    end
    local fromMulti = rotatingShopFilterStringFromValues(vals)
    if not fromMulti or fromMulti == "" then
        fromMulti = "*"
    end
    local extra = ""
    if inputRef and type(inputRef.Get) == "function" then
        local s = inputRef.Get()
        if type(s) == "string" then
            extra = s
        end
    end
    return mergeRotatingShopExtra(fromMulti, extra)
end

local function rotatingShopValuesFromSavedFilter(savedCsv, options)
    local out, seen = {}, {}
    local opts = type(options) == "table" and options or ROTATING_SHOP_ITEM_OPTIONS
    local raw = type(savedCsv) == "string" and savedCsv or ""
    local wantStar = false
    local wanted = {}
    for part in string.gmatch(raw, "[^,]+") do
        local token = (part:match("^%s*(.-)%s*$") or "")
        if #token > 0 then
            if token == "*" then
                wantStar = true
            else
                wanted[string.lower(token)] = true
            end
        end
    end
    local function add(v)
        if type(v) ~= "string" or #v == 0 or seen[v] then
            return
        end
        seen[v] = true
        out[#out + 1] = v
    end
    if wantStar then
        add("*")
    end
    for _, opt in ipairs(opts) do
        local val = type(opt) == "table" and (opt.value or opt[2]) or opt
        if type(val) == "string" and wanted[string.lower(val)] then
            add(val)
        end
    end
    if #out == 0 and next(wanted) == nil then
        add("*")
    end
    return out
end

