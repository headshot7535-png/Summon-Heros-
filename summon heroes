--- Returns ok, reason where reason: used_new, kept, buy_failed, no_module, no_unit, no_match, all_locked
local function tryStatRerollOnce(opts)
    opts = opts or {}
    local upgrades = getUnitUpgradesModule()
    if not upgrades or type(upgrades.BuyStatReroll) ~= "function" or type(upgrades.RerollAction) ~= "function" then
        return false, "no_module"
    end

    local nameFilter = opts.unitNameFilter
    if getgenv and type(getgenv().BonusChestStatRerollUnit) == "string" and #getgenv().BonusChestStatRerollUnit > 0 then
        nameFilter = getgenv().BonusChestStatRerollUnit
    end

    local unit = resolveStatRerollUnit(nameFilter)
    if not unit then
        local trim = type(nameFilter) == "string" and (nameFilter:match("^%s*(.-)%s*$") or "") or ""
        if #trim > 0 then
            return false, "no_match"
        end
        return false, "no_unit"
    end

    local locked = buildStatRerollLockedList(opts.lockAtk, opts.lockHp, opts.lockCd, opts.lockSpd)
    local unlocked = getStatRerollUnlockedKeys(locked)
    if #unlocked == 0 then
        return false, "all_locked"
    end

    local curves = getCurvesModule()
    local mode = opts.mode or "always"
    if getgenv and (getgenv().BonusChestStatRerollMode == "better" or getgenv().BonusChestStatRerollMode == "always") then
        mode = getgenv().BonusChestStatRerollMode
    end

    local function sumUnlockedLetters(letterTable, useUnit)
        local s = 0
        for _, k in ipairs(unlocked) do
            local L
            if useUnit then
                L = getUnitStatLetter(unit, k)
            else
                L = letterTable and letterTable[k]
            end
            s = s + statLetterScore(L, curves)
        end
        return s
    end

    local oldSum = sumUnlockedLetters(nil, true)

    local newStats
    local okBuy, ret = pcall(function()
        return upgrades:BuyStatReroll(LP, unit, locked)
    end)
    if not okBuy or ret == nil or type(ret) ~= "table" then
        return false, "buy_failed"
    end
    newStats = ret

    local useNew = true
    if mode == "better" then
        local newSum = sumUnlockedLetters(newStats, false)
        useNew = newSum > oldSum
    end

    pcall(function()
        upgrades:RerollAction(LP, useNew and "UseNew" or "KeepCurrent")
    end)

    return true, useNew and "used_new" or "kept"
end

