--- SetQueue(slot, mapKey, stage) then LaunchQueue(slot); uses resolve* remotes (same as full UI path).
function trySetQueueThenLaunchQueueForPadModel(padModel, mapKey, stageNum)
    if not padModel then
        return false
    end
    local gap = 0.35
    if getgenv and type(getgenv().BonusChestSetQueueLaunchGap) == "number" then
        gap = math.clamp(getgenv().BonusChestSetQueueLaunchGap, 0.05, 3)
    end

    -- Server does a server-side magnitude check against padModel.Door before
    -- honouring RequestEnterQueue. We briefly teleport to the Door, invoke,
    -- then return to the original position. Total time: ~0.6s, invisible in
    -- normal play and safe to do before any loading screen appears.
    local reqEnterEv = resolveRequestEnterQueueRemote()
    if reqEnterEv then
        local char    = LP.Character
        local root    = char and char:FindFirstChild("HumanoidRootPart")
        local door    = padModel:FindFirstChild("Door", true)

        local originalCF = root and root.CFrame
        if root and door then
            -- Teleport onto the door (4 studs above centre to avoid clipping)
            root.CFrame = door.CFrame + Vector3.new(0, 4, 0)
            task.wait(0.1)   -- let server register the new position
        else
            if not root then print("[SH] RequestEnterQueue: no HumanoidRootPart, skipping teleport") end
            if not door then print("[SH] RequestEnterQueue: no Door child found on padModel") end
        end

        local ok, success, needMapSelect, errMsg = pcall(function()
            return reqEnterEv:InvokeServer(padModel)
        end)

        -- Return to original position immediately, before any wait
        if root and originalCF then
            root.CFrame = originalCF
        end

        if ok then
            print("[SH] RequestEnterQueue ->", success, needMapSelect, errMsg)
        else
            print("[SH] RequestEnterQueue pcall error:", success)
        end
        task.wait(0.15)
    else
        print("[SH] RequestEnterQueue remote not found - proceeding anyway")
    end

    local setEv = resolveSetQueueRemote()
    if setEv then
        if setEv:IsA("RemoteFunction") then
            pcall(function()
                setEv:InvokeServer(padModel, mapKey, stageNum)
            end)
        else
            pcall(function()
                setEv:FireServer(padModel, mapKey, stageNum)
            end)
        end
        task.wait(gap)
    end
    local launchEv = resolveLaunchQueueRemote()
    if launchEv and not (getgenv and getgenv().BonusChestSkipLaunchQueue == true) then
        local ok = select(1, pcall(function()
            launchEv:FireServer(padModel)
        end))
        return ok
    end
    return setEv ~= nil
end

