--- summonSellDelayInputRef / saved — forward refs ok when delay fires.
local summonSellDelayInputRef

local function schedulePostSummonAutoSell(units)
    if type(units) ~= "table" or #units == 0 then
        return
    end
    local delaySec = 12
    if getgenv and type(getgenv().BonusChestSummonSellDelay) == "number" then
        delaySec = getgenv().BonusChestSummonSellDelay
    elseif summonSellDelayInputRef then
        delaySec = tonumber(summonSellDelayInputRef.Get()) or delaySec
    else
        delaySec = tonumber(saved.summonSellDelaySec) or delaySec
    end
    delaySec = math.clamp(delaySec, 0, 120)
    local snapshot = {}
    for _, u in ipairs(units) do
        if typeof(u) == "Instance" then
            snapshot[#snapshot + 1] = u
        end
    end
    if #snapshot == 0 then
        return
    end
    task.delay(delaySec, function()
        local items = getItemsModule()
        local inv = getInventoryModule()
        local st = getSettingsModule()
        if not items or not inv or not st then
            return
        end
        if type(items.GetItemData) ~= "function" or type(inv.SellItems) ~= "function" or type(st.GetConfig) ~= "function" then
            return
        end
        local toSell = {}
        for _, u in ipairs(snapshot) do
            if u and u.Parent then
                local d = items:GetItemData(u.Name)
                local r = d and d.Rarity
                if r then
                    local cfg = st:GetConfig(LP, "AutoSell_Rarity" .. tostring(r))
                    if cfg and cfg.Value == true then
                        toSell[#toSell + 1] = u
                    end
                end
            end
        end
        if #toSell > 0 then
            pcall(function()
                inv:SellItems(LP, toSell)
            end)
        end
    end)
end

