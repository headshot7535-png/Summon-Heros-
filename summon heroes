--- Try m:Name(self, LP, ...) for common quest claim exports.
local function pcallQuestMethod(m, methodName, ...)
    if not m or type(m[methodName]) ~= "function" then
        return false
    end
    local args = { ... }
    local ok = pcall(function()
        if #args == 0 then
            m[methodName](m, LP)
        else
            m[methodName](m, LP, unpack(args))
        end
    end)
    return ok
end

local function tryClaimQuestCategoryViaModule(m, category)
